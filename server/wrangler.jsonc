// Cloudflare Worker for swiss-passport.com: the website (static files from ../site, built into ./public)
// plus the MCP endpoint /mcp (src/worker.ts). Deployed by Cloudflare Workers Builds on every push to main
// (root directory server/, build: npm ci && npm run build && npm run site, deploy: npx wrangler deploy).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "swiss-passport",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Everything else is served as static files without running the Worker.
    "run_worker_first": ["/mcp"],
    // Unknown addresses get /404.html with status 404.
    "not_found_handling": "404-page"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "swiss-passport",
      "database_id": "c4c8a8e2-9141-4f8c-af91-eaccf6d5ece3",
      "migrations_dir": "migrations"
    }
  ],
  // Daily: delete progress 12 months after the last activity (see the privacy policy).
  // Every 10 minutes: report new and changed pages to IndexNow (src/indexnow.ts).
  "triggers": { "crons": ["30 3 * * *", "*/10 * * * *"] },
  // Workers Logs: calls of /mcp and their errors in the dashboard, kept 3 days (privacy policy).
  // Request bodies (learner code, answers) are not logged.
  "observability": { "enabled": true },
  // www redirects to the root with a Cloudflare redirect rule (dashboard: Rules > Redirect Rules).
  "routes": [{ "pattern": "swiss-passport.com", "custom_domain": true }],
  // Only the real domain: no *.workers.dev copy of the site.
  "workers_dev": false,
  "preview_urls": false
}
