{
  "name": "@aleksejdix/learning-engine",
  "version": "0.1.0",
  "description": "Learning engine for multiple-choice courses: lessons with prerequisites, spaced repetition per topic and mock exams. No content: a catalog is passed in.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AleksejDix/swiss-passport.git",
    "directory": "packages/engine"
  },
