# macOS
.DS_Store

# Official documents: linked in sources/README.md, not redistributed here
sources/*.pdf
sources/*.txt
sources/*.html

# Dependencies and build output (packages/, mcp/)
node_modules/
packages/*/dist/
mcp/dist/
mcp/data/
mcp/api/
mcp/release/
mcp/*.mcpb
mcp/scripts/preview/out/

# Local env files
.env*

# Website (site/): build goes into mcp/public, images are copied from images/
mcp/public/
site/public/images/
site/.astro/

# Cloudflare Worker (mcp/): local dev state
mcp/.wrangler/

# Private notes and issues: local only, never committed
/private/

# Quality checks: Playwright reports and the local visual reference (e2e/visual.spec.ts)
playwright-report/
test-results/
e2e/__screenshots__/
