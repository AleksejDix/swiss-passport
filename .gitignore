# macOS
.DS_Store

# Official documents: linked in sources/README.md, not redistributed here
sources/*.pdf
sources/*.txt
sources/*.html

# Dependencies and build output (server/)
node_modules/
server/dist/
server/data/
server/api/
server/release/
server/*.mcpb
server/scripts/preview/out/

# Local env files
.env*

# Website (site/): build goes into server/public, images are copied from images/
server/public/
site/public/images/
site/.astro/

# Cloudflare Worker (server/): local dev state
server/.wrangler/

# Private notes and issues: local only, never committed
/private/
