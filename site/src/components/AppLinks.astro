---
// The AI apps with their logos, each linking to its steps on the connect page.
import { CONNECT, LOGOS } from "../connect.js";
import { connectPath } from "../data.js";

const { lang, here = false } = Astro.props;
const base = here ? "" : connectPath(lang);
---
<ul class="apps">
  {CONNECT[lang].apps.map((app) => (
    <li><a href={`${base}#${app.id}`}><svg class="logo" viewBox="0 0 24 24" fill="currentColor" fill-rule="evenodd" aria-hidden="true" set:html={LOGOS[app.id]} />{app.name}</a></li>
  ))}
</ul>
