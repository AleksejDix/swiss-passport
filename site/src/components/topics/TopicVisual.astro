---
// The figure that belongs to a topic (see src/viz/topic-visuals.js), on topic and question pages.
import HistoryTimeline from "./HistoryTimeline.astro";
import Parliament from "./Parliament.astro";
import FederalCouncil from "./FederalCouncil.astro";
import Powers from "./Powers.astro";
import Levels from "./Levels.astro";
import Pillars from "./Pillars.astro";
import Majority from "./Majority.astro";
import GeoMap from "./GeoMap.astro";
import { visualFor } from "../../viz/topic-visuals.js";

const { lang, topic, caption = true } = Astro.props;
const kind = visualFor(topic);
---
{kind === "history" && <HistoryTimeline lang={lang} current={topic} caption={caption} />}
{kind === "parliament" && <Parliament lang={lang} caption={caption} />}
{kind === "federalCouncil" && <FederalCouncil lang={lang} caption={caption} />}
{kind === "powers" && <Powers lang={lang} caption={caption} />}
{kind === "levels" && <Levels lang={lang} caption={caption} />}
{kind === "pillars" && <Pillars lang={lang} caption={caption} />}
{kind === "majority" && <Majority lang={lang} caption={caption} />}
{kind === "map" && <GeoMap lang={lang} topic={topic} caption={caption} />}
