---
// The majority of the cantons (issue #8): the canton map with the six former half-cantons in red, their value in
// cantonal votes and the sum 20 × 1 + 6 × ½ = 23, of which 12 are needed. The map is one shared file
// (/cantons.svg), so the pages stay light. Texts: key terms and the homepage's vote strings.
import { MAP } from "../../scripts/map-data.js";
import { termName, termText } from "../../viz/terms.ts";
import { texts } from "../../i18n.ts";

interface Props {
  lang: string;
  /** Show the figure's own title (off where the page heading already names it). */
  caption?: boolean;
}

const { lang, caption = true } = Astro.props;
const c = texts(lang).concepts;
const s = texts(lang).site.home;
const title = termName(c, lang, "double_majority", "Ständemehr");
const full = MAP.cantons.filter((k) => !k.half).length;
const halves = MAP.cantons.filter((k) => k.half).length;
const sum = `${full} × 1 + ${halves} × ½ = ${full + halves / 2} ${s.hero_votes}`;
---

<figure class="maj">
  {caption && <figcaption class="maj-title">{title}</figcaption>}
  <p class="maj-def">{termText(c, lang, "double_majority", "Ständemehr")}</p>
  <img
    class="maj-map"
    src="/cantons.svg"
    width={MAP.width}
    height={MAP.height}
    alt={`${title}: ${sum}. ${s.hero_rule}`}
    loading="lazy"
    decoding="async"
  />
  <ul class="maj-legend">
    <li>
      <i class="sw"></i>
      {termName(c, lang, "three_levels", "Kanton")} <b>1</b> <span>× {full}</span>
    </li>
    <li>
      <i class="sw half"></i>
      {termName(c, lang, "three_levels", "Halbkanton")} <b>½</b> <span>× {halves}</span>
    </li>
  </ul>
  <p class="maj-sum">{sum}</p>
  <p class="maj-rule">{s.hero_rule}</p>
  <p class="maj-credit">{s.map_credit}</p>
</figure>

<style>
  /* The majority of the cantons (components/topics/Majority.astro): grey cantons, the former half-cantons red. */
  .maj {
    margin-block: var(--line);
  }
  .maj-title {
    font-weight: 700;
  }
  .maj-def {
    font-size: var(--xs);
    line-height: var(--xs-lh);
    color: var(--grey);
    margin-top: 0.1875rem;
  }
  .maj-map {
    display: block;
    width: 100%;
    max-width: 36rem;
    height: auto;
    margin-top: 0.75rem;
  }
  .maj-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.5rem;
    margin-top: 0.75rem;
  }
  .maj-legend li {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
  }
  .maj-legend .sw {
    width: 0.75rem;
    height: 0.75rem;
    background: var(--light);
    flex: none;
    transform: translateY(0.0625rem);
  }
  .maj-legend .sw.half {
    background: var(--red);
  }
  .maj-legend span {
    color: var(--grey);
  }
  .maj-sum {
    font-size: var(--m);
    line-height: var(--m-lh);
    font-weight: 700;
    margin-top: 0.75rem;
  }
  .maj-rule {
    margin-top: 0.1875rem;
  }
  .maj-credit {
    font-size: var(--xs);
    line-height: var(--xs-lh);
    color: var(--grey);
    margin-top: 0.5rem;
  }
  :global(.row:has(> div > .maj:first-child) > *) {
    align-self: start;
  }
</style>
