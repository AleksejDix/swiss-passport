---
// A map for a geography topic (issues #13, #14): the shared SVG file of the map, and over it the marks and
// names in the reader's language. Marks keep their size on every screen; the map scales.
import { MAP_OF_TOPIC, MAP_LEGEND, geometry, mapMarks } from "../../viz/maps.ts";
import { termName } from "../../viz/terms.ts";
import { texts } from "../../i18n.ts";

interface Props {
  lang: string;
  /** A geography topic with a map (MAP_OF_TOPIC). */
  topic: string;
  caption?: boolean;
}

const { lang, topic, caption = true } = Astro.props;
const name = MAP_OF_TOPIC[topic];
const g = geometry(name);
const t: Record<string, string> = texts(lang).site.viz.map;
const marks = mapMarks(name, lang);
// A legend entry names a map text or a key term of a topic.
const legend = (MAP_LEGEND[name] ?? []).map(([key, a, term]) => [
  key,
  term ? termName(texts(lang).concepts, lang, a, term) : t[a],
]);
---

<figure class={`geo geo-${name}`}>
  {caption && <figcaption class="geo-title">{texts(lang).concepts[topic].title}</figcaption>}
  <div class="geo-box">
    <img src={`/maps/${name}.svg`} width={g.width} height={g.height} alt="" loading="lazy" decoding="async" />
    <ul class="geo-marks">
      {marks.map((m) => (
        <li
          class={`mk mk-${m.kind} ${m.side
            .split(" ")
            .map((c) => (c === "wrap" ? c : `at-${c}`))
            .join(" ")}${m.strong ? " is-strong" : ""}`}
          style={`--x:${m.x.toFixed(2)}%;--y:${m.y.toFixed(2)}%`}
        >
          <span>
            {m.rank && <b>{m.rank}</b>}
            {m.text}
          </span>
        </li>
      ))}
    </ul>
    {name === "ch-size" && (
      <>
        <p class="dim dim-x">
          <span>350 {t.km}</span>
        </p>
        <p class="dim dim-y">
          <span>220 {t.km}</span>
        </p>
      </>
    )}
  </div>
  {legend.length > 0 && (
    <ul class="geo-legend">
      {legend.map(([key, text]) => (
        <li>
          <i class={`key key-${key}`}></i>
          {text}
        </li>
      ))}
    </ul>
  )}
  <p class="geo-credit">{t.credit}</p>
</figure>

<style>
  /* Maps of the geography topics (components/topics/GeoMap.astro). The map is an image; marks and names lie
     over it at fixed sizes, set like the rest of the site. Names carry a white halo so they read on any fill. */
  .geo {
    margin-block: var(--line);
  }
  .geo-title {
    font-weight: 700;
    margin-bottom: 0.75rem;
  }
  .geo-box {
    position: relative;
  }
  .geo-box img {
    display: block;
    width: 100%;
    height: auto;
  }
  .geo-credit {
    font-size: var(--xs);
    line-height: var(--xs-lh);
    color: var(--grey);
    margin-top: 0.75rem;
  }
  .geo-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    margin-top: 0.75rem;
    font-size: var(--xs);
    line-height: var(--xs-lh);
  }
  .geo-legend li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .key {
    flex: none;
    display: inline-block;
    width: 0.75rem;
    height: 0.75rem;
    background: var(--ink);
  }
  .key-square {
    width: 0.5625rem;
    height: 0.5625rem;
  }
  .key-diamond {
    width: 0.4375rem;
    height: 0.4375rem;
    margin-inline: 0.15625rem;
    transform: rotate(45deg);
  }
  .key-field {
    background: var(--field);
    box-shadow: inset 0 0 0 1px var(--rule);
  }
  .key-light {
    background: var(--light);
  }
  .key-dark {
    background: var(--dark);
  }
  .key-red {
    background: var(--red);
  }
  :global(.row:has(> div > .geo:first-child) > *) {
    align-self: start;
  }
  .geo-marks {
    position: absolute;
    inset: 0;
    font-size: var(--xs);
    line-height: var(--xs-lh);
    pointer-events: none;
  }
  .mk {
    position: absolute;
    left: var(--x);
    top: var(--y);
    width: 0;
    height: 0;
  }
  .mk span {
    position: absolute;
    white-space: nowrap;
    text-shadow:
      0 0 2px var(--paper),
      0 0 2px var(--paper),
      0 0 3px var(--paper),
      0 0 4px var(--paper);
  }
  .mk b {
    margin-right: 0.25rem;
    font-variant-numeric: tabular-nums;
  }
  .mk.is-strong span {
    font-weight: 700;
  }
  /* Marks: centred on their point, with a ring in the paper colour. */
  .mk::before {
    content: "";
    position: absolute;
    box-shadow: 0 0 0 1.5px var(--paper);
    background: var(--ink);
  }
  .mk-dot::before {
    width: 0.5rem;
    height: 0.5rem;
    margin: -0.25rem;
    border-radius: 50%;
  }
  .mk-square::before {
    width: 0.5625rem;
    height: 0.5625rem;
    margin: -0.28125rem;
  }
  .mk-diamond::before {
    width: 0.4375rem;
    height: 0.4375rem;
    margin: -0.21875rem;
    transform: rotate(45deg);
  }
  .mk-peak::before {
    width: 0.75rem;
    height: 0.625rem;
    margin: -0.375rem 0 0 -0.375rem;
    clip-path: polygon(50% 0, 100% 100%, 0 100%);
    box-shadow: none;
  }
  .mk.is-strong::before {
    background: var(--red);
  }
  .mk-area::before,
  .mk-place::before {
    content: none;
  }
  /* Names on surfaces: bold on the area; places around the map in grey. */
  .mk-area span {
    font-weight: 700;
  }
  .mk-place span {
    color: var(--grey);
  }
  .mk-place.is-strong span {
    color: var(--ink);
    font-weight: 400;
  }
  /* The name of a red area stands in white on it (4.6:1). */
  .mk-area.is-strong span {
    color: var(--paper);
    text-shadow: none;
  }
  /* Where the name sits next to its point. */
  .at-e span {
    left: 0.5rem;
    transform: translateY(-50%);
  }
  .at-w span {
    right: 0.5rem;
    transform: translateY(-50%);
  }
  .at-n span {
    bottom: 0.375rem;
    transform: translateX(-50%);
  }
  .at-s span {
    top: 0.375rem;
    transform: translateX(-50%);
  }
  .at-c span {
    transform: translate(-50%, -50%);
  }
  .at-ne span {
    bottom: 0.25rem;
    left: 0.375rem;
  }
  .at-se span {
    top: 0.375rem;
    left: 0;
  }
  .wrap span {
    white-space: normal;
    width: max-content;
    max-width: 6.5rem;
    text-align: center;
  }
  /* Extent of Switzerland: the width and the height of the map itself. */
  .geo-ch-size .geo-box {
    margin-bottom: calc(2 * var(--line));
  }
  .dim {
    position: absolute;
    font-size: var(--xs);
    line-height: var(--xs-lh);
  }
  .dim::before {
    content: "";
    position: absolute;
    border: 0 solid var(--ink);
  }
  .dim-x {
    left: 0;
    right: 0;
    top: 100%;
    height: var(--line);
    text-align: center;
  }
  .dim-x::before {
    left: 0;
    right: 0;
    top: 0.375rem;
    height: 0.375rem;
    border-width: 0 1px 1px;
  }
  .dim-x span {
    position: relative;
    top: 0.375rem;
    padding-inline: 0.375rem;
    background: var(--paper);
  }
  .dim-y {
    top: 0;
    bottom: 0;
    left: 0;
    width: 0.375rem;
  }
  .dim-y::before {
    top: 0;
    bottom: 0;
    left: 0;
    width: 0.375rem;
    border-width: 1px 0 1px 1px;
  }
  .dim-y span {
    position: absolute;
    top: 25%;
    left: 0.75rem;
    white-space: nowrap;
  }
</style>
