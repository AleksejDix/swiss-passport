---
// The Federal Assembly (issue #3): the National Council (200 seats) and the Council of States (46 seats)
// as semicircles at the same scale; in the Council of States the six seats of the former half-cantons are rings.
// Labels are the key terms of parliament_chambers; the last line is the memory aid of parliament_tasks.
import { TEXT } from "../../data.ts";
import { hemicycle, type Seat } from "../../viz/hemicycle.ts";
import { PARLIAMENT_TEXT } from "../../viz/parliament.ts";

interface Props {
  lang: string;
  /** Show the figure's own title (off where the page heading already names it). */
  caption?: boolean;
}

const { lang, caption = true } = Astro.props;
const p = PARLIAMENT_TEXT[lang];
const terms = TEXT[lang].concepts.parliament_chambers.key_terms;
const def = (term: string) => terms.find((k) => k.term === term)!.definition;
const tasks = TEXT[lang].concepts.parliament_tasks.mnemonic;

const national = hemicycle(200);
const states = hemicycle(46);
const OUTER = 100; // radius of the National Council
const dot = national.step * OUTER * 0.36;
const outerStates = dot / (states.step * 0.36); // same seat size in both chambers
const HALF_CANTON_SEATS = 6; // the last six seats of the Council of States

const chamber = (h: ReturnType<typeof hemicycle>, outer: number, half = 0) => {
  const pad = dot + 1.5;
  const view = [-outer - pad, -outer - pad, 2 * (outer + pad), outer + 2 * pad].map((v) => v.toFixed(1)).join(" ");
  const rows = Array.from({ length: h.rows }, (_, row) =>
    h.seats.map((s, i) => ({ ...s, i })).filter((s) => s.row === row),
  );
  return { view, width: 2 * (outer + pad), rows, outer, half, total: h.seats.length };
};
const nc = chamber(national, OUTER);
const cs = chamber(states, outerStates, HALF_CANTON_SEATS);
const seat = (c: ReturnType<typeof chamber>, s: Seat & { i: number }) => ({
  cx: (s.x * c.outer).toFixed(1),
  cy: (s.y * c.outer).toFixed(1),
  r: dot.toFixed(2),
  half: s.i >= c.total - c.half,
});
---

<figure
  class="parl"
  style={`--nc:${nc.width.toFixed(1)};--cs:${cs.width.toFixed(1)};--nc-col:${nc.width.toFixed(1)}fr;--cs-col:${cs.width.toFixed(1)}fr`}
>
  {caption && <figcaption class="parl-title">{p.title}</figcaption>}
  <div class="parl-chambers">
    {[nc, cs].map((c, k) => (
      <svg class={`parl-seats ${k ? "parl-cs" : "parl-nc"}`} viewBox={c.view} aria-hidden="true">
        {c.rows.map((row, i) => (
          <g class="parl-row" style={`--i:${i}`}>
            {row.map((s) => {
              const d = seat(c, s);
              return <circle class={d.half ? "half" : undefined} cx={d.cx} cy={d.cy} r={d.r} />;
            })}
          </g>
        ))}
      </svg>
    ))}
    <div class="parl-label parl-nc-label">
      <p class="parl-num">200</p>
      <p class="parl-term" lang="de">
        Nationalrat
      </p>
      <p class="parl-def">{def("Nationalrat")}</p>
    </div>
    <div class="parl-label parl-cs-label">
      <p class="parl-num">46</p>
      <p class="parl-term" lang="de">
        Ständerat
      </p>
      <p class="parl-def">{def("Ständerat")}</p>
      <ul class="parl-legend">
        <li>
          <i class="seat"></i>
          {p.cantons}
        </li>
        <li>
          <i class="seat half"></i>
          {p.halves}
        </li>
      </ul>
    </div>
  </div>
  <div class="parl-united">
    <p class="parl-num">200 + 46 = 246</p>
    <p class="parl-term" lang="de">
      Vereinigte Bundesversammlung
    </p>
    <p class="parl-def">
      {def("Vereinigte Bundesversammlung")} {tasks}
    </p>
  </div>
</figure>

<style>
  /* The Federal Assembly (components/topics/Parliament.astro): black seats, the half-canton seats as rings.
     Both chambers use one seat size, so the Council of States is drawn as much smaller as it is. */
  .parl {
    margin-block: var(--line);
  }
  .parl-title {
    font-weight: 700;
  }
  .parl-chambers {
    display: grid;
    gap: 0.75rem var(--gutter);
    margin-top: var(--line);
  }
  .parl-seats {
    display: block;
    width: 100%;
    height: auto;
  }
  .parl-seats circle {
    fill: var(--ink);
  }
  .parl-seats circle.half {
    fill: var(--paper);
    stroke: var(--ink);
    stroke-width: 1.25;
    vector-effect: non-scaling-stroke;
  }
  /* Phones: one chamber after the other, the small one at its true size relative to the large one. */
  .parl-nc {
    order: 1;
  }
  .parl-nc-label {
    order: 2;
  }
  .parl-cs {
    order: 3;
    margin-top: var(--line);
    width: calc(var(--cs) / var(--nc) * 100%);
  }
  .parl-cs-label {
    order: 4;
  }
  /* Wider screens: the chambers side by side on one baseline, column widths in proportion, labels below. */
  @media (min-width: 40rem) {
    .parl-chambers {
      grid-template-columns: var(--nc-col) var(--cs-col);
    }
    .parl-chambers > * {
      order: 0;
    }
    .parl-seats {
      align-self: end;
    }
    .parl-cs {
      width: 100%;
      margin-top: 0;
    }
  }
  .parl-num {
    font-size: var(--l);
    line-height: var(--l-lh);
    font-weight: 700;
    letter-spacing: -0.02em;
  }
  .parl-term {
    font-weight: 700;
  }
  .parl-def {
    font-size: var(--xs);
    line-height: var(--xs-lh);
    color: var(--grey);
    margin-top: 0.1875rem;
  }
  .parl-legend {
    margin-top: 0.75rem;
    font-size: var(--xs);
    line-height: var(--xs-lh);
  }
  .parl-legend li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .parl-legend .seat {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--ink);
    flex: none;
  }
  .parl-legend .seat.half {
    background: var(--paper);
    box-shadow: inset 0 0 0 1.25px var(--ink);
  }
  .parl-united {
    margin-top: calc(1.5 * var(--line));
    padding-top: 0.75rem;
    border-top: 1px solid var(--rule);
  }
  /* Seats appear row by row as the figure scrolls into view, where the browser supports it. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .parl {
        view-timeline: --parl block;
      }
      .parl-row {
        animation: parl-in linear both;
        animation-timeline: --parl;
        animation-range: entry calc(15% + var(--i) * 7%) entry calc(40% + var(--i) * 7%);
      }
      @keyframes parl-in {
        from {
          opacity: 0;
        }
        to {
          opacity: 1;
        }
      }
    }
  }
  /* A row that starts with the figure has no first text line to align its heading with: align both to the top. */
  :global(.row:has(> div > .parl:first-child) > *) {
    align-self: start;
  }
</style>
