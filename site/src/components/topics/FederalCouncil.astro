---
// The Federal Council (issue #4): seven members in one frame ("seven heads, one voice"), one of them President of
// the Confederation for a year; each member heads one of the seven departments; the Federal Chancellery supports
// them without being a member. Names and abbreviations come from the topic texts (src/viz/federal-council.js).
import { TEXT } from "../../data.ts";
import { FEDERAL_COUNCIL_TEXT, departments } from "../../viz/federal-council.ts";

interface Props {
  lang: string;
  /** Show the figure's own title (off where the page heading already names it). */
  caption?: boolean;
}

const { lang, caption = true } = Astro.props;
const c = TEXT[lang].concepts;
const term = (topic: string, name: string) => {
  const k = c[topic].key_terms.find((k) => k.term === name);
  if (!k) throw new Error(`key term ${name} missing in ${lang}/${topic}`);
  return k.definition;
};
const german = departments(TEXT.de.concepts.administration.intro[1]).map((d) => d.abbr);
const depts = departments(c.administration.intro[1]);
if (depts.length !== 7) throw new Error(`expected 7 departments in ${lang}, found ${depts.length}`);
const PRESIDENT = 3; // which dot is marked does not matter: the presidency changes every year
---

<figure class="fc">
  {caption && <figcaption class="fc-title">{FEDERAL_COUNCIL_TEXT[lang].title}</figcaption>}
  <div class="fc-council">
    <div class="fc-seven" aria-hidden="true">
      {Array.from({ length: 7 }, (_, i) => (
        <i class={i === PRESIDENT ? "dot president" : "dot"} style={`--i:${i}`}></i>
      ))}
    </div>
    <div>
      <p class="fc-term" lang="de">
        Bundesrat
      </p>
      <p class="fc-def">
        {term("federal_council", "Bundesrat")} {c.federal_council.mnemonic}
      </p>
      <p class="fc-key">
        <i class="dot president"></i>
        <span>
          <span lang="de">Bundespräsident/in</span>: {term("federal_council", "Bundespräsident/Bundespräsidentin")}
        </span>
      </p>
    </div>
  </div>
  <p class="fc-def fc-lead">{term("administration", "Departement")}</p>
  <ol class="fc-depts">
    {depts.map((d, i) => (
      <li style={`--i:${i}`}>
        <i class="dot"></i>
        <b lang="de">{german[i]}</b>
        <span>
          {d.name}
          {d.abbr !== german[i] && ` (${d.abbr})`}
        </span>
      </li>
    ))}
  </ol>
  <p class="fc-chancellery">
    <i class="dot open"></i>
    <b lang="de">Bundeskanzlei</b>
    <span>
      {term("administration", "Bundeskanzlei")} {c.administration.mnemonic}
    </span>
  </p>
</figure>

<style>
  /* The Federal Council (components/topics/FederalCouncil.astro). Black dots are members, the red one the
     President of the Confederation, the open one the Federal Chancellery (not a member). */
  .fc {
    margin-block: var(--line);
  }
  .fc-title {
    font-weight: 700;
  }
  .fc .dot {
    display: inline-block;
    width: 0.75rem;
    height: 0.75rem;
    border-radius: 50%;
    background: var(--ink);
    flex: none;
  }
  .fc .dot.president {
    background: var(--red);
  }
  .fc .dot.open {
    background: var(--paper);
    box-shadow: inset 0 0 0 1.25px var(--ink);
  }
  .fc-council {
    display: grid;
    gap: 0.75rem var(--gutter);
    margin-top: var(--line);
    align-items: start;
  }
  @media (min-width: 40rem) {
    .fc-council {
      grid-template-columns: auto 1fr;
    }
  }
  /* Seven heads in one frame: they decide as one body. */
  .fc-seven {
    display: inline-flex;
    gap: 0.5rem;
    padding: 0.625rem 0.75rem;
    border: 1px solid var(--ink);
    border-radius: 999px;
    justify-self: start;
  }
  .fc-seven .dot {
    width: 1.125rem;
    height: 1.125rem;
  }
  .fc-term {
    font-weight: 700;
  }
  .fc-def {
    font-size: var(--xs);
    line-height: var(--xs-lh);
    color: var(--grey);
    margin-top: 0.1875rem;
  }
  .fc-key {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    margin-top: 0.5rem;
    font-size: var(--xs);
    line-height: var(--xs-lh);
  }
  .fc-key .dot {
    width: 0.625rem;
    height: 0.625rem;
    transform: translateY(0.0625rem);
  }
  .fc-lead {
    margin-top: var(--line);
  }
  .fc-depts {
    margin-top: 0.5rem;
    border-top: 1px solid var(--rule);
  }
  .fc-depts li,
  .fc-chancellery {
    display: grid;
    grid-template-columns: 0.75rem 3.5rem 1fr;
    column-gap: 0.75rem;
    align-items: baseline;
    padding-block: 0.375rem;
    border-bottom: 1px solid var(--rule);
  }
  .fc-depts .dot,
  .fc-chancellery .dot {
    transform: translateY(0.0625rem);
  }
  /* "Bundeskanzlei" is longer than an abbreviation: name and explanation stack beside the open dot. */
  .fc-chancellery {
    margin-top: 0.75rem;
    border-bottom: 0;
    grid-template-columns: 0.75rem 1fr;
  }
  .fc-chancellery span {
    grid-column: 2;
    margin-top: 0.1875rem;
    font-size: var(--xs);
    line-height: var(--xs-lh);
    color: var(--grey);
  }
  /* The seven dots and the departments appear one after another, where scroll-driven animation is supported. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .fc {
        view-timeline: --fc block;
      }
      .fc-seven .dot,
      .fc-depts li {
        animation: fc-in linear both;
        animation-timeline: --fc;
        animation-range: entry calc(10% + var(--i) * 5%) entry calc(35% + var(--i) * 5%);
      }
      @keyframes fc-in {
        from {
          opacity: 0;
          transform: translateY(0.375rem);
        }
        to {
          opacity: 1;
          transform: none;
        }
      }
    }
  }
  /* A row that starts with the figure: heading and figure both at the top. */
  :global(.row:has(> div > .fc:first-child) > *) {
    align-self: start;
  }
</style>
