---
// Timeline of Swiss history on the history topics and their questions (issue #1). Static HTML, no JavaScript.
// The gap before an entry grows with the time since the previous one (square root, so centuries stay readable).
import { TEXT, topicPath } from "../../data.ts";
import { HISTORY, TIMELINE_TEXT, yearLabel, withoutYear } from "../../viz/history.ts";

interface Props {
  lang: string;
  /** The topic of this page, marked on the timeline. */
  current?: string;
  caption?: boolean;
}

const { lang, current, caption = true } = Astro.props;
const title = TIMELINE_TEXT[lang].title;
const gap = (i: number) => (i ? Math.min(3, 0.1 * Math.sqrt(HISTORY[i].year - HISTORY[i - 1].year)) : 0).toFixed(2);
---

<figure class="htl" aria-label={caption ? undefined : title}>
  {caption && <figcaption class="htl-title">{title}</figcaption>}
  <ol class="htl-list">
    {HISTORY.map((e, i) => {
      const name = withoutYear(TEXT[lang].concepts[e.topic].title);
      const here = e.topic === current;
      return (
        <li
          class={here ? "is-current" : undefined}
          aria-current={here ? "true" : undefined}
          style={`--gap:${gap(i)}rem`}
        >
          <span class="htl-year">{yearLabel(e, lang)}</span>
          {here ? (
            <span class="htl-what">{name}</span>
          ) : (
            <a class="htl-what" href={topicPath(lang, { id: e.topic })}>
              {name}
            </a>
          )}
        </li>
      );
    })}
  </ol>
</figure>

<style>
  /* Timeline of Swiss history (components/topics/HistoryTimeline.astro): a black line with open dots;
     the current topic is a red dot. Text stays black and grey; the red dot carries the emphasis. */
  .htl {
    margin-block: var(--line);
  }
  .htl-title {
    font-weight: 700;
  }
  .htl-list {
    position: relative;
    margin-top: 0.75rem;
  }
  .htl-list::before {
    content: "";
    position: absolute;
    left: 0.3125rem;
    top: 0.75rem;
    bottom: 0.75rem;
    width: 1px;
    background: var(--ink);
  }
  .htl-list li {
    position: relative;
    display: grid;
    grid-template-columns: 9rem 1fr;
    column-gap: 0.75rem;
    padding: 0.125rem 0 0.125rem 1.75rem;
    margin-top: var(--gap, 0);
  }
  .htl-list li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.5rem;
    width: 0.625rem;
    height: 0.625rem;
    border-radius: 50%;
    background: var(--paper);
    box-shadow: inset 0 0 0 1px var(--ink);
  }
  .htl-list .is-current::before {
    left: -0.125rem;
    top: 0.375rem;
    width: 0.875rem;
    height: 0.875rem;
    background: var(--red);
    box-shadow: 0 0 0 2px var(--paper);
  }
  .htl-year {
    color: var(--grey);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  @media (max-width: 39.99rem) {
    .htl-list li {
      grid-template-columns: 7rem 1fr;
    }
  }
  .htl-what {
    color: var(--ink);
  }
  a.htl-what {
    text-decoration: none;
  }
  a.htl-what:hover {
    color: var(--red);
    text-decoration: underline;
  }
  .htl-list .is-current :is(.htl-year, .htl-what) {
    color: var(--ink);
    font-weight: 700;
  }
  /* Entries slide in as they scroll into view, where the browser supports scroll-driven animation. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .htl-list li {
        animation: htl-in linear both;
        animation-timeline: view();
        animation-range: entry 0% entry 80%;
      }
      @keyframes htl-in {
        from {
          opacity: 0;
          transform: translateX(-0.5rem);
        }
        to {
          opacity: 1;
          transform: none;
        }
      }
    }
  }
</style>
