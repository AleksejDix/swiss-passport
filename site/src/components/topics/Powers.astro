---
// Separation of powers (issue #5): legislature, executive and judiciary, each at federal level and in the
// Canton of Zurich, with what it does; the media as the fourth power outside the state.
import { membersLabel } from "../../viz/powers.ts";
import { termName } from "../../viz/terms.ts";
import { texts } from "../../i18n.ts";

interface Props {
  lang: string;
  /** Show the figure's own title (off where the page heading already names it). */
  caption?: boolean;
}

const { lang, caption = true } = Astro.props;
const p = texts(lang).site.viz.powers;
const c = texts(lang).concepts;
const name = (topic: string, term: string) => termName(c, lang, topic, term);
// The media line: its definition without the name in front ("Fourth power: …"), which is shown in bold.
const media = c.separation_of_powers.key_terms.find((k) => k.term === "Vierte Gewalt")!.definition;
const mediaText = lang === "de" ? media : media.replace(/^[^:,]*[:,]\s*/, "");
// A body: its topic and German key term (or no topic and a plain name), and a detail such as the seats.
type Body = [topic: string | null, term: string, detail: string | null];
const powers: { term: string; does: string; federal: Body[]; canton: Body[] }[] = [
  {
    term: "Legislative",
    does: p.make,
    federal: [
      [
        "parliament_chambers",
        "Bundesversammlung",
        `${name("parliament_chambers", "Nationalrat")} ${200} + ${name("parliament_chambers", "Ständerat")} ${46}`,
      ],
    ],
    canton: [["zh_parliament", "Kantonsrat", membersLabel(lang, 180)]],
  },
  {
    term: "Exekutive",
    does: p.execute,
    federal: [["federal_council", "Bundesrat", membersLabel(lang, 7)]],
    canton: [["zh_government", "Regierungsrat", membersLabel(lang, 7)]],
  },
  {
    term: "Judikative",
    does: p.judge,
    federal: [["justice_police", "Bundesgericht", "Lausanne"]],
    canton: [[null, p.courts, null]],
  },
];
---

<figure class="pow">
  {caption && <figcaption class="pow-title">{p.title}</figcaption>}
  <p class="pow-control">{p.control}</p>
  <div class="pow-cols">
    {powers.map((pw, i) => (
      <div class="pow-col" style={`--i:${i}`}>
        <p class="pow-name">{name("separation_of_powers", pw.term)}</p>
        {lang !== "de" && (
          <p class="pow-de" lang="de">
            {pw.term}
          </p>
        )}
        <p class="pow-does">{pw.does}</p>
        {(
          [
            [p.federal, pw.federal],
            [p.canton, pw.canton],
          ] as [string, Body[]][]
        ).map(([level, bodies]) => (
          <div class="pow-body">
            <p class="pow-level">{level}</p>
            {bodies.map(([topic, term, detail]) => (
              <>
                <p class="pow-org">{topic ? name(topic, term) : term}</p>
                {topic && lang !== "de" && (
                  <p class="pow-de" lang="de">
                    {term}
                  </p>
                )}
                {detail && <p class="pow-detail">{detail}</p>}
              </>
            ))}
          </div>
        ))}
      </div>
    ))}
  </div>
  <p class="pow-media">
    <i class="dot open"></i>
    <span>
      <b>{name("separation_of_powers", "Vierte Gewalt")}</b> {mediaText}
    </span>
  </p>
</figure>

<style>
  /* Separation of powers (components/topics/Powers.astro): three columns under one rule that stands for mutual
     control; each column a power with its body at federal level and in the Canton of Zurich. */
  .pow {
    margin-block: var(--line);
  }
  .pow-title {
    font-weight: 700;
  }
  .pow-control {
    font-size: var(--xs);
    line-height: var(--xs-lh);
    color: var(--grey);
    margin-top: 0.375rem;
  }
  .pow-cols {
    display: grid;
    gap: var(--line) var(--gutter);
    margin-top: 0.75rem;
  }
  @media (min-width: 40rem) {
    .pow-cols {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      border-top: 2px solid var(--ink);
      padding-top: 0.75rem;
    }
  }
  .pow-col {
    border-top: 2px solid var(--ink);
    padding-top: 0.5rem;
  }
  @media (min-width: 40rem) {
    .pow-col {
      border-top: 0;
      padding-top: 0;
    }
  }
  .pow-name {
    font-weight: 700;
  }
  .pow-de {
    font-size: var(--xs);
    line-height: var(--xs-lh);
    color: var(--grey);
  }
  .pow-does {
    color: var(--red);
    font-weight: 700;
    margin-top: 0.1875rem;
  }
  .pow-body {
    margin-top: 0.75rem;
    padding-top: 0.5rem;
    border-top: 1px solid var(--rule);
  }
  .pow-level {
    font-size: var(--xs);
    line-height: var(--xs-lh);
    color: var(--grey);
  }
  .pow-org {
    font-weight: 700;
    margin-top: 0.1875rem;
  }
  .pow-detail {
    font-size: var(--xs);
    line-height: var(--xs-lh);
    color: var(--grey);
  }
  .pow-media {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    margin-top: var(--line);
    font-size: var(--xs);
    line-height: var(--xs-lh);
    color: var(--grey);
  }
  .pow-media b {
    color: var(--ink);
  }
  .pow .dot.open {
    display: inline-block;
    width: 0.625rem;
    height: 0.625rem;
    flex: none;
    border-radius: 50%;
    box-shadow: inset 0 0 0 1.25px var(--ink);
    transform: translateY(0.0625rem);
  }
  :global(.row:has(> div > .pow:first-child) > *) {
    align-self: start;
  }
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .pow {
        view-timeline: --pow block;
      }
      .pow-col {
        animation: pow-in linear both;
        animation-timeline: --pow;
        animation-range: entry calc(10% + var(--i) * 10%) entry calc(40% + var(--i) * 10%);
      }
      @keyframes pow-in {
        from {
          opacity: 0;
          transform: translateY(0.5rem);
        }
        to {
          opacity: 1;
          transform: none;
        }
      }
    }
  }
</style>
