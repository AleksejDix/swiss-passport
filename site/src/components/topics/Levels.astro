---
// The three levels of the state (issue #6): 1 Confederation, 26 cantons, about 2200 municipalities, all as dots at
// one scale (the municipalities as an exact 100 × 22 dot pattern, so the page stays light). The Confederation
// carries its tasks; the memory aid of federal_tasks says who does what.
import "../../styles/levels.css";
import { TEXT } from "../../data.ts";
import { termName } from "../../viz/terms.ts";
import { LEVELS_TEXT, MUNICIPALITIES as M } from "../../viz/levels.ts";

interface Props {
  lang: string;
  /** Show the figure's own title (off where the page heading already names it). */
  caption?: boolean;
}

const { lang, caption = true } = Astro.props;
const c = TEXT[lang].concepts;
const name = (topic: string, term: string) => termName(c, lang, topic, term);
const half = c.three_levels.key_terms.find((k) => k.term === "Halbkanton")!.definition;
const halfText = lang === "de" ? half : half.replace(/^[^:,]*[:,]\s*/, "");
const tasks = ["Aussenpolitik", "Geldpolitik", "Zoll", "Soziale Sicherheit"].map((t) => name("federal_tasks", t));
const W = 312; // all rows share one width and one scale
const S = W / M.cols; // spacing of the municipality dots
const cantons = Array.from({ length: 26 }, (_, i) => ({ x: 6 + i * 12, half: i >= 20 }));
const numberFmt = new Intl.NumberFormat(lang === "de" ? "de-CH" : lang);
---

<figure class="lvl">
  {caption && <figcaption class="lvl-title">{LEVELS_TEXT[lang].title}</figcaption>}
  <div class="lvl-rows">
    <div class="lvl-row" style="--i:0">
      <p class="lvl-name">{name("three_levels", "Bund")}</p>
      <p class="lvl-num">1</p>
      <svg viewBox={`0 0 ${W} 12`} aria-hidden="true">
        <circle cx="6" cy="6" r="4.5" />
      </svg>
      <p class="lvl-tasks">{tasks.join(" · ")}</p>
    </div>
    <div class="lvl-row" style="--i:1">
      <p class="lvl-name">{name("three_levels", "Kanton")}</p>
      <p class="lvl-num">
        26 <span>= 20 + 6</span>
      </p>
      <svg viewBox={`0 0 ${W} 12`} aria-hidden="true">
        {cantons.map((k) =>
          k.half ? (
            <g>
              <circle class="ring" cx={k.x} cy="6" r="4" />
              <path d={`M${k.x} 1.5 A4.5 4.5 0 0 0 ${k.x} 10.5 Z`} />
            </g>
          ) : (
            <circle cx={k.x} cy="6" r="4.5" />
          ),
        )}
      </svg>
      <p class="lvl-key">
        <svg viewBox="0 0 12 12" aria-hidden="true">
          <circle class="ring" cx="6" cy="6" r="4" />
          <path d="M6 1.5 A4.5 4.5 0 0 0 6 10.5 Z" />
        </svg>
        <span>
          <span lang="de">Halbkanton</span>: {halfText}
        </span>
      </p>
    </div>
    <div class="lvl-row" style="--i:2">
      <p class="lvl-name">{name("three_levels", "Gemeinde")}</p>
      <p class="lvl-num">
        ≈ {numberFmt.format(M.count)} <span>({M.year})</span>
      </p>
      <svg viewBox={`0 0 ${W} ${(M.rows * S).toFixed(2)}`} aria-hidden="true">
        <defs>
          <pattern id="lvl-municipality" width={S.toFixed(3)} height={S.toFixed(3)} patternUnits="userSpaceOnUse">
            <circle cx={(S / 2).toFixed(3)} cy={(S / 2).toFixed(3)} r={(S * 0.36).toFixed(3)} />
          </pattern>
        </defs>
        <rect width={W} height={(M.rows * S).toFixed(2)} fill="url(#lvl-municipality)" />
      </svg>
    </div>
  </div>
  <p class="lvl-note">{c.federal_tasks.mnemonic}</p>
</figure>
