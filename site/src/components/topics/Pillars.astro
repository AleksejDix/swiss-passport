---
// The three pillars of old-age provision (issue #7): three pillars under a roof labelled with the reference age;
// under each its key term and definition; the memory aid and supplementary benefits below. All texts are key
// terms and memory aids of three_pillars and ahv_iv; the title is the topic title.
import { termName, termText } from "../../viz/terms.ts";
import { texts } from "../../i18n.ts";

interface Props {
  lang: string;
  /** Show the figure's own title (off where the page heading already names it). */
  caption?: boolean;
}

const { lang, caption = true } = Astro.props;
const c = texts(lang).concepts;
const name = (topic: string, term: string) => termName(c, lang, topic, term);
const text = (topic: string, term: string) => termText(c, lang, topic, term);
const pillars = ["Erste Säule", "Zweite Säule", "Dritte Säule"];
---

<figure class="plr">
  {caption && <figcaption class="plr-title">{c.three_pillars.title}</figcaption>}
  <div class="plr-house">
    <p class="plr-roof">{name("ahv_iv", "Referenzalter")} 65</p>
    <div class="plr-cols">
      {pillars.map((term, i) => (
        <div class="plr-col" style={`--i:${i}`}>
          <div class="plr-pillar" aria-hidden="true">
            <span>{i + 1}</span>
          </div>
          <p class="plr-name">{name("three_pillars", term)}</p>
          {lang !== "de" && (
            <p class="plr-de" lang="de">
              {term}
            </p>
          )}
          <p class="plr-def">{text("three_pillars", term)}</p>
        </div>
      ))}
    </div>
  </div>
  <p class="plr-note">{c.three_pillars.mnemonic}</p>
  <p class="plr-el">
    <b>{name("ahv_iv", "Ergänzungsleistungen (EL)")}</b> {text("ahv_iv", "Ergänzungsleistungen (EL)")}
  </p>
</figure>

<style>
  /* The three pillars (components/topics/Pillars.astro): black pillars with white numerals under one roof. */
  .plr {
    margin-block: var(--line);
  }
  .plr-title {
    font-weight: 700;
  }
  .plr-house {
    margin-top: 0.75rem;
  }
  .plr-roof {
    background: var(--ink);
    color: var(--paper);
    font-weight: 700;
    padding: 0.375rem 0.75rem;
  }
  .plr-cols {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0 var(--gutter);
  }
  .plr-pillar {
    height: 7.5rem;
    margin-inline: 18%;
    background: var(--ink);
    color: var(--paper);
    display: flex;
    justify-content: center;
    padding-top: 0.5rem;
    transform-origin: top;
  }
  .plr-pillar span {
    font-size: var(--l);
    line-height: var(--l-lh);
    font-weight: 700;
  }
  .plr-name {
    font-weight: 700;
    margin-top: 0.75rem;
    border-top: 2px solid var(--ink);
    padding-top: 0.5rem;
  }
  .plr-de,
  .plr-def {
    font-size: var(--xs);
    line-height: var(--xs-lh);
    color: var(--grey);
  }
  .plr-def {
    margin-top: 0.1875rem;
  }
  .plr-note {
    margin-top: var(--line);
  }
  .plr-el {
    font-size: var(--xs);
    line-height: var(--xs-lh);
    color: var(--grey);
    margin-top: 0.5rem;
  }
  .plr-el b {
    color: var(--ink);
  }
  :global(.row:has(> div > .plr:first-child) > *) {
    align-self: start;
  }
  /* Phones: narrower pillars; text stays in three columns but smaller gaps. */
  @media (max-width: 39.99rem) {
    .plr-cols {
      column-gap: 0.75rem;
    }
    .plr-pillar {
      height: 5.5rem;
      margin-inline: 12%;
    }
  }
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .plr {
        view-timeline: --plr block;
      }
      .plr-pillar {
        animation: plr-grow linear both;
        animation-timeline: --plr;
        animation-range: entry calc(15% + var(--i) * 10%) entry calc(45% + var(--i) * 10%);
      }
      @keyframes plr-grow {
        from {
          transform: scaleY(0.1);
        }
        to {
          transform: none;
        }
      }
    }
  }
</style>
