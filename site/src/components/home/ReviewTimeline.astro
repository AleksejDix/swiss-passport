---
// "Reviews at the right time" on the homepage: the days after a lesson (1, 3, 7, 14, 30) on a square-root scale,
// so the growing gaps stay visible. scripts/main.js draws the axis and drops the days in when it scrolls into view.
const DAYS = [1, 3, 7, 14, 30];
---

<div class="timeline" data-timeline aria-hidden="true">
  <div class="axis"></div>
  {DAYS.map((d) => (
    <span style={`--d:${d}`}>{d}</span>
  ))}
</div>

<style>
  :global(.row) .timeline {
    grid-column: 1 / -1;
  }
  .timeline {
    position: relative;
    height: calc(2 * var(--line));
    margin-top: var(--line);
  }
  .axis {
    position: absolute;
    left: 0;
    right: 0;
    top: 0.75rem;
    height: 1px;
    background: var(--ink);
    transform-origin: left;
  }
  .axis::before {
    content: "";
    position: absolute;
    left: 0;
    top: -0.3125rem;
    width: 1px;
    height: 0.6875rem;
    background: var(--ink);
  }
  .timeline span {
    position: absolute;
    top: 0;
    left: calc(sqrt(var(--d) / 30) * 100%);
    transform: translateX(-50%);
    width: var(--line);
    height: var(--line);
    display: grid;
    place-items: center;
    background: var(--red);
    color: var(--paper);
    font-size: var(--xs);
    font-weight: 700;
    letter-spacing: 0;
    font-variant-numeric: tabular-nums;
  }
  .timeline span:last-child {
    transform: translateX(-100%);
  }
  /* Motion: hidden at the start only when the script runs the sequence. */
  :global(.js-motion) [data-timeline] .axis {
    transform: scaleX(0);
  }
  :global(.js-motion) [data-timeline] span {
    opacity: 0;
  }
</style>
