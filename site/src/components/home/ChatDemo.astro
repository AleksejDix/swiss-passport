---
// "How it works" as a short chat (issue #9): one real lesson step, as the tutor runs it in Claude or ChatGPT:
// the learner picks a language, the tutor explains, asks a real exam question, checks the answer and says why.
// scripts/chat-demo.js plays it once when it scrolls into view; without it the whole chat is shown.
import { question } from "../../data.ts";
import { termText } from "../../viz/terms.ts";
import { CHAT_TOPIC, CHAT_QUESTION } from "../../viz/chat.ts";
import { texts } from "../../i18n.ts";

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const t = texts(lang).site.viz.chat;
const c = texts(lang).concepts;
const q = question(CHAT_QUESTION);
const text = texts(lang).questions[CHAT_QUESTION];
const de = texts("de").questions[CHAT_QUESTION];
const letters = q.options.map((o) => o.id);
---

<figure class="chat" data-chat>
  <figcaption class="chat-title">{t.title}</figcaption>
  <ol class="chat-log">
    <li class="msg you">
      <p class="who">{t.you}</p>
      <p class="bubble">{t.pick}</p>
    </li>
    <li class="msg tutor">
      <p class="who">{t.tutor}</p>
      <div class="bubble">
        <p>
          <b>{c[CHAT_TOPIC].mnemonic}</b>
        </p>
        <p>{termText(c, lang, CHAT_TOPIC, "Kollegialitätsprinzip")}</p>
      </div>
    </li>
    <li class="msg tutor">
      <p class="who">{t.tutor}</p>
      <div class="bubble">
        <p>
          <b>{text.question}</b>
        </p>
        {lang !== "de" && (
          <p class="de" lang="de">
            {de.question}
          </p>
        )}
        <ol class="opts">
          {letters.map((l) => (
            <li data-letter={l} class={l === q.answer ? "is-right" : undefined}>
              <span class="l">{l.toUpperCase()}</span>
              <span>{text.options[l]}</span>
            </li>
          ))}
        </ol>
      </div>
    </li>
    <li class="msg you">
      <p class="who">{t.you}</p>
      <p class="bubble">{q.answer.toUpperCase()}</p>
    </li>
    <li class="msg tutor" data-answer={q.answer}>
      <p class="who">{t.tutor}</p>
      <div class="bubble">
        <p>
          <b class="ok">{texts(lang).site.home.hero_right}</b> {text.why}
        </p>
      </div>
    </li>
  </ol>
</figure>

<script>
  import "../../scripts/chat-demo.js";
</script>

<style>
  /* "How it works" chat (components/home/ChatDemo.astro): the tutor on the left in grey, the learner on the right in black. */
  :global(.row) .chat {
    margin-top: var(--line);
  }
  .chat-title {
    font-weight: 700;
  }
  .chat-log {
    display: grid;
    gap: 0.75rem;
    margin-top: 0.75rem;
    max-width: 34rem;
  }
  .msg {
    display: grid;
    max-width: 88%;
    position: relative;
  }
  .msg.you {
    justify-self: end;
    justify-items: end;
  }
  .msg .who {
    font-size: var(--xs);
    line-height: var(--xs-lh);
    color: var(--grey);
  }
  .bubble {
    padding: 0.5rem 0.75rem;
    margin-top: 0.1875rem;
  }
  .bubble > * + * {
    margin-top: 0.375rem;
  }
  .tutor .bubble {
    background: var(--field);
  }
  .you .bubble {
    background: var(--ink);
    color: var(--paper);
    font-weight: 700;
  }
  .chat .de {
    font-size: var(--xs);
    line-height: var(--xs-lh);
    color: var(--grey);
  }
  .chat .opts li {
    display: grid;
    grid-template-columns: 1.5rem 1fr;
    align-items: baseline;
    font-size: var(--xs);
    line-height: var(--xs-lh);
    padding-top: 0.25rem;
  }
  .chat .opts .l {
    display: inline-grid;
    place-items: center;
    width: 1.125rem;
    height: 1.125rem;
    border: 1px solid var(--ink);
    font-weight: 700;
    /* stylelint-disable-next-line scale-unlimited/declaration-strict-value -- the letter in an 18px box of the chat, smaller than the smallest text size */
    font-size: 0.6875rem;
    transition:
      background-color 0.3s,
      color 0.3s,
      border-color 0.3s;
  }
  /* The right answer is marked once the learner has answered (the class is there without JavaScript). */
  .chat .opts li.is-right .l {
    background: var(--red);
    border-color: var(--red);
    color: var(--paper);
  }
  .chat .ok {
    color: var(--red);
  }
  /* While the chat plays, messages keep their space (so nothing below moves) but are invisible;
     the typing indicator sits on top of that space instead of taking its own. */
  .msg.pending > :not(.typing) {
    visibility: hidden;
  }
  .chat :global(.typing) {
    position: absolute;
    top: var(--xs-lh);
    left: 0;
    display: inline-flex;
    gap: 0.25rem;
    padding: 0.625rem 0.75rem;
    background: var(--field);
    margin-top: 0.1875rem;
  }
  .chat :global(.typing i) {
    width: 0.375rem;
    height: 0.375rem;
    border-radius: 50%;
    background: var(--grey);
    animation: chat-dot 1s infinite ease-in-out;
  }
  .chat :global(.typing i:nth-child(2)) {
    animation-delay: 0.15s;
  }
  .chat :global(.typing i:nth-child(3)) {
    animation-delay: 0.3s;
  }
  @keyframes chat-dot {
    0%,
    80%,
    100% {
      opacity: 0.3;
    }
    40% {
      opacity: 1;
    }
  }
</style>
