---
// "Do I have to take the test?" (issue #10): the canton's four exemption questions as a flowchart. Without
// JavaScript it reads as a chart (yes → no test, four times no → test); scripts/self-check.js lets you answer.
import { LINKS } from "../../guide.ts";
import { texts } from "../../i18n.ts";

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const t = texts(lang).site.viz.check;
---

<figure class="chk" data-check data-result-no={t.resultNo} data-result-yes={t.resultYes}>
  <figcaption class="chk-title">{t.caption}</figcaption>
  <ol class="chk-steps">
    {t.qs.map((q, i) => (
      <li class="chk-step" data-step={i}>
        <span class="chk-n">{i + 1}</span>
        <p class="chk-q">{q}</p>
        <p class="chk-yes">
          <b>{t.yes}</b> → {t.noTest}
        </p>
        <p class="chk-buttons">
          <button type="button" data-answer="yes">
            {t.yes}
          </button>
          <button type="button" data-answer="no">
            {t.no}
          </button>
        </p>
      </li>
    ))}
    <li class="chk-end">
      <span class="chk-n">!</span>
      <p>
        <b>{t.allNo}</b> {t.test}
      </p>
    </li>
  </ol>
  <div class="chk-out" data-out aria-live="polite" hidden>
    <p class="chk-result" data-result></p>
    <p>
      <button type="button" class="chk-again" data-again>
        {t.again}
      </button>
    </p>
  </div>
  <p class="chk-note">
    {t.note}{" "}
    <a href={LINKS.zh} rel="noopener">
      {t.link}
    </a>
  </p>
</figure>

<script>
  import "../../scripts/self-check.js";
</script>

<style>
  /* Test guide visuals (components/guide/): the self-check flowchart and the two orders of test and application. */
  :global(.row) .chk {
    grid-column: 1 / -1;
    margin-top: var(--line);
  }
  @media (min-width: 40rem) {
    :global(.row) .chk {
      grid-column: 1 / span 6;
    }
  }
  .chk-title {
    font-weight: 700;
  }
  /* ---- Self-check: numbered steps; "yes" leads out to "no test", four times "no" to the end */
  .chk-steps {
    margin-top: 0.75rem;
  }
  .chk-step,
  .chk-end {
    display: grid;
    grid-template-columns: 1.5rem 1fr;
    column-gap: 0.75rem;
    padding-block: 0.625rem;
    border-top: 1px solid var(--rule);
    transition: opacity 0.2s;
  }
  .chk-step > :not(.chk-n),
  .chk-end > :not(.chk-n) {
    grid-column: 2;
  }
  .chk-n {
    grid-row: 1 / span 3;
    width: 1.5rem;
    height: 1.5rem;
    display: grid;
    place-items: center;
    border: 1px solid var(--ink);
    font-size: var(--xs);
    font-weight: 700;
    transition:
      background-color 0.2s,
      color 0.2s,
      border-color 0.2s;
  }
  .chk-q {
    font-weight: 700;
  }
  .chk-yes {
    font-size: var(--xs);
    line-height: var(--xs-lh);
    color: var(--grey);
    margin-top: 0.1875rem;
  }
  /* The buttons keep their space on every step (no layout shift) and show on the current one only. */
  .chk-buttons {
    display: flex;
    gap: 0.5rem;
    margin-top: 0.5rem;
    visibility: hidden;
  }
  .chk-buttons button,
  .chk-again {
    font: inherit;
    font-weight: 700;
    padding: 0.375rem 1rem;
    cursor: pointer;
    border: 1px solid var(--ink);
    background: var(--paper);
    color: var(--ink);
  }
  .chk-buttons button:hover,
  .chk-again:hover {
    background: var(--ink);
    color: var(--paper);
  }
  .chk.is-live .chk-step.is-active .chk-buttons {
    visibility: visible;
  }
  /* Steps not reached yet are grey (5.3:1, still readable), not faded. */
  .chk.is-live .chk-step:not(.is-active, .is-no, .is-yes),
  .chk.is-live .chk-end:not(.is-hit) {
    color: var(--grey);
  }
  .chk.is-live .chk-step:not(.is-active, .is-no, .is-yes) .chk-n,
  .chk.is-live .chk-end:not(.is-hit) .chk-n {
    border-color: var(--grey);
  }
  .chk-step.is-no .chk-n {
    background: var(--ink);
    color: var(--paper);
  }
  .chk-step.is-yes .chk-n,
  .chk-end.is-hit .chk-n {
    background: var(--red);
    border-color: var(--red);
    color: var(--paper);
  }
  .chk-step.is-yes .chk-yes {
    color: var(--red);
    font-weight: 700;
  }
  .chk-end.is-hit p {
    color: var(--red);
  }
  .chk-out {
    margin-top: 0.75rem;
  }
  .chk-result {
    font-size: var(--m);
    line-height: var(--m-lh);
    font-weight: 700;
  }
  .chk-out p + p {
    margin-top: 0.5rem;
  }
  .chk-note {
    font-size: var(--xs);
    line-height: var(--xs-lh);
    color: var(--grey);
    margin-top: 0.75rem;
  }
  /* ---- Two orders of test and application; the test is the red step */
</style>
