---
import { texts } from "../../i18n.ts";
// When is the test? (issue #10) Two orders, because it depends on the municipality (zh.ch); the City of Zurich
// tests only after the application (stadt-zuerich.ch). The test is the red step.

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const t = texts(lang).site.viz.order;
const flows = [
  { label: t.before, steps: [t.when, t.test, t.apply] },
  { label: t.after, steps: [t.apply, t.when, t.test] },
];
---

<figure class="ord">
  <figcaption class="ord-title">{t.caption}</figcaption>
  {flows.map((f) => (
    <div class="ord-flow">
      <p class="ord-label">{f.label}</p>
      <ol class="ord-steps">
        {f.steps.map((s) => (
          <li class={s === t.test ? "is-test" : undefined}>{s}</li>
        ))}
      </ol>
    </div>
  ))}
  <p class="ord-note">{t.note}</p>
</figure>

<style>
  /* Test guide visuals (components/guide/): the self-check flowchart and the two orders of test and application. */
  :global(.row) .ord {
    grid-column: 1 / -1;
    margin-top: var(--line);
  }
  @media (min-width: 40rem) {
    :global(.row) .ord {
      grid-column: 1 / span 6;
    }
  }
  .ord-title {
    font-weight: 700;
  }
  /* ---- Self-check: numbered steps; "yes" leads out to "no test", four times "no" to the end */
  /* The buttons keep their space on every step (no layout shift) and show on the current one only. */
  /* Steps not reached yet are grey (5.3:1, still readable), not faded. */
  /* ---- Two orders of test and application; the test is the red step */
  .ord-flow {
    margin-top: 0.75rem;
  }
  .ord-label {
    font-size: var(--xs);
    line-height: var(--xs-lh);
    color: var(--grey);
  }
  .ord-steps {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1.75rem;
    margin-top: 0.25rem;
  }
  .ord-steps li {
    position: relative;
    padding: 0.25rem 0.625rem;
    border: 1px solid var(--ink);
  }
  .ord-steps li + li::before {
    content: "→";
    position: absolute;
    left: -1.375rem;
    color: var(--grey);
  }
  .ord-steps li.is-test {
    background: var(--red);
    border-color: var(--red);
    color: var(--paper);
    font-weight: 700;
  }
  .ord-note {
    font-size: var(--xs);
    line-height: var(--xs-lh);
    color: var(--grey);
    margin-top: 0.75rem;
  }
</style>
