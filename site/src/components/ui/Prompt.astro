---
// The question of a figure on the method page, and under it the German wording of the real test.
// With switchable, scripts/method-viz.js swaps the texts ([data-q], [data-q-de]).
interface Props {
  question: string;
  lang: string;
  /** The German wording; left out when the page is German. */
  german?: string;
  /** Rendered but hidden (the page is German, a script may show it). */
  germanHidden?: boolean;
  switchable?: boolean;
}

const { question, lang, german, germanHidden = false, switchable = false } = Astro.props;
---

<p class="q" lang={lang} data-q={switchable ? "" : undefined}>
  {question}
</p>
{german !== undefined && (
  <p class="de" lang="de" data-q-de={switchable ? "" : undefined} hidden={germanHidden}>
    {german}
  </p>
)}

<style>
  /* In a figure, set closer to what precedes it than a paragraph. */
  :global(.viz) .q {
    margin-top: 0.375rem;
  }
  .q {
    font-size: var(--m);
    line-height: var(--m-lh);
    letter-spacing: -0.012em;
    font-weight: 700;
    margin-top: 0.75rem;
  }
  .de {
    color: var(--grey);
    margin-top: 0.375rem;
  }
</style>
