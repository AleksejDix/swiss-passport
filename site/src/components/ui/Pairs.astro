---
// Labels and what they label, inside a row: a subheading (h3) or term (dt) in the first three columns of the
// content, its text beside it. In the list of all questions a lesson (h3) stands further apart than a topic (h4).
interface Props {
  /** "dl" for terms and definitions. */
  as?: "div" | "dl";
}

const { as: Tag = "div" } = Astro.props;
---

<Tag class="pairs">
  <slot />
</Tag>

<style>
  :global(.row) .pairs > :global(:is(h3, dt)) {
    grid-column: 1 / -1;
  }
  :global(.row) .pairs > :global(h3:not(:first-child)) {
    margin-top: var(--line);
  }
  :global(.row) .pairs > :global(h3:not(:first-child):has(+ h4)) {
    margin-top: calc(2 * var(--line));
  }
  .pairs > :global(h4) {
    margin-top: var(--line);
  }
  .pairs > :global(h3 + h4) {
    margin-top: 0;
  }
  .pairs > :global(h4 + ol) {
    margin-top: 0.375rem;
  }
  @media (min-width: 40rem) {
    :global(.row) .pairs > :global(:is(h3, dt)) {
      grid-column: 1 / span 3;
    }
    :global(.row) .pairs > :global(:not(h3, dt)) {
      grid-column: 4 / span 5;
    }
    :global(.row) .pairs > :global(dt:not(:first-child)),
    :global(.row) .pairs > :global(dt:not(:first-child) + dd) {
      margin-top: 0.75rem;
    }
  }
  @media (min-width: 64rem) {
    :global(.row) .pairs > :global(:not(h3, dt)) {
      grid-column: 4 / span 6;
    }
  }
</style>
