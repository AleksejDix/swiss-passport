---
// One answer of a question: the letter in a square, then the answer. The same row on question pages, the
// method page and (in learn.css until /learn is built from components) in /learn. A static item (li) shows the
// right answer; a button reacts to the pointer and takes the states a script sets: chosen, is-right, is-wrong.
interface Props {
  letter: string;
  as?: "li" | "button";
  /** Marks the right answer. */
  right?: boolean;
  /** Language of the answer text. */
  lang?: string;
  class?: string;
}

const { letter, as: Tag = "li", right = false, lang, class: className } = Astro.props;
---

<Tag
  class:list={["choice", className, { "is-right": right }]}
  type={Tag === "button" ? "button" : undefined}
  data-letter={letter}
>
  <b>{letter.toUpperCase()}</b>
  <span lang={lang}>
    <slot />
  </span>
</Tag>

<style>
  .choice {
    display: grid;
    grid-template-columns: 2.25rem minmax(0, 1fr);
    align-items: start;
    padding-block: 0.75rem;
    border-top: 1px solid var(--rule);
  }
  button.choice {
    width: 100%;
    font: inherit;
    letter-spacing: inherit;
    text-align: left;
    color: var(--ink);
    background: var(--paper);
    cursor: pointer;
    border-inline: 0;
    border-bottom: 0;
    padding-inline: 0;
  }
  .choice b {
    width: var(--line);
    height: var(--line);
    display: grid;
    place-items: center;
    border: 1px solid var(--ink);
    font-size: var(--xs);
    line-height: 1;
    letter-spacing: 0;
  }
  /* The German wording under the answer. */
  .choice :global(small) {
    display: block;
    color: var(--grey);
    font-size: var(--xs);
    line-height: var(--xs-lh);
    font-weight: 400;
    margin-top: 0.1875rem;
  }
  button.choice:hover:not(:disabled) b {
    border-color: var(--red);
    color: var(--red);
  }
  button.choice:disabled {
    cursor: default;
  }
  .choice.chosen b {
    background: var(--ink);
    color: var(--paper);
  }
  .choice.is-right b {
    background: var(--red);
    border-color: var(--red);
    color: var(--paper);
  }
  .choice.is-right span {
    font-weight: 700;
  }
  .choice.is-right :global(small) {
    font-weight: 400;
  }
  .choice.is-wrong span {
    color: var(--grey);
    text-decoration: line-through;
    text-decoration-thickness: 1px;
  }
</style>
