---
// A row of the page: a rule, the heading in the first three columns, the content in the other nine. Content blocks
// (div, ol, ul, dl) share the columns of the page through subgrid, so everything inside lines up with everything
// else; running text never runs wider than six columns.
interface Props {
  /** The heading (h2). For a heading with more than text, use the heading slot. */
  title?: string;
  /** Id of the heading, which labels the section. */
  id?: string;
  /** Id of the section itself, as a link target. */
  anchor?: string;
  lang?: string;
  /** "nav" for a row of links. */
  as?: "section" | "nav";
  /** Accessible name of a nav row without a heading. */
  label?: string;
  class?: string;
}

const { title, id, anchor, lang, as: Tag = "section", label, class: className } = Astro.props;
const heading = Astro.slots.has("heading");
---

<Tag class:list={["row", className]} id={anchor} lang={lang} aria-labelledby={id} aria-label={label}>
  {heading ? (
    <h2 id={id}>
      <slot name="heading" />
    </h2>
  ) : (
    title && <h2 id={id}>{title}</h2>
  )}
  <slot />
</Tag>

<style>
  .row {
    display: grid;
    grid-template-columns: var(--grid);
    column-gap: var(--gutter);
    align-items: first baseline;
    border-top: 1px solid var(--ink);
    padding-block: calc(var(--line) - 1px) calc(3 * var(--line));
  }
  .row > :global(*) {
    grid-column: 1 / -1;
  }
  .row > h2 {
    margin-bottom: var(--line);
  }
  .row > :global(:is(div, ol, ul, dl)) {
    display: grid;
    grid-template-columns: subgrid;
    align-items: first baseline;
    align-content: start;
  }
  .row > :global(:is(div, ol, ul, dl) > *) {
    grid-column: 1 / -1;
  }
  /* The flow of text in a row: paragraphs, and subheadings with what follows them. */
  .row :global(p + p) {
    margin-top: 0.75rem;
  }
  .row :global(h3) {
    margin-top: calc(2 * var(--line));
  }
  .row :global(:is(div, dl) > h3:first-child) {
    margin-top: 0;
  }
  .row :global(h3 + :is(p, dl, ul)) {
    margin-top: 0.375rem;
  }
  @media (min-width: 40rem) {
    /* Running text never runs wider than six columns. */
    .row > :global(:is(div, ol, ul, dl) > *) {
      grid-column: 1 / span 6;
    }
  }
  @media (min-width: 64rem) {
    .row {
      padding-bottom: calc(4 * var(--line));
    }
    .row > h2 {
      grid-column: 1 / span 3;
      margin-bottom: 0;
    }
    .row > :global(:not(h2)) {
      grid-column: 4 / -1;
    }
  }
</style>
