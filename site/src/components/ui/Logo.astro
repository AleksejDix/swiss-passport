---
// The logo of an AI app, in the colour of the text. Logos: LobeHub Icons (MIT); the marks are trademarks of their owners.
import { LOGOS } from "../../connect.ts";

interface Props {
  /** claude, chatgpt, grok, mistral, perplexity */
  app: string;
  /** Sized for a heading. */
  large?: boolean;
}

const { app, large = false } = Astro.props;
---

<svg
  class:list={["logo", { large }]}
  viewBox="0 0 24 24"
  fill="currentColor"
  fill-rule="evenodd"
  aria-hidden="true"
  set:html={LOGOS[app]}
/>

<style>
  .logo {
    flex: none;
    width: 1.25rem;
    height: 1.25rem;
  }
  .large {
    width: 1.375rem;
    height: 1.375rem;
    margin-right: 0.5rem;
    vertical-align: -0.1875rem;
  }
</style>
