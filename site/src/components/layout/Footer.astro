---
// The footer, set on the page grid like the masthead above it. An optional support band first (a sentence and a
// button, in the reading size, lined up with the text). Then the name and what the site is, the links in groups
// under the masthead's columns (the first under the main menu, the last under the languages), and a bottom line
// with the copyright and the note that this is not an official service. On phones the groups stand two by two.
// The page the reader is on is set in bold, as in the menus.
import Button from "../ui/Button.astro";
import { ariaCurrent } from "../../data.ts";

interface Link {
  href: string;
  label: string;
  /** The language of the linked page, when it differs from this page. */
  lang?: string;
}

interface Group {
  /** Without a title the links stand alone: on the language picker and on /learn, which switch language. */
  title?: string;
  links: Link[];
}

interface Props {
  support?: { text: string; label: string; href: string };
  /** What the site is, under the name. */
  tagline?: string;
  groups: Group[];
  /** On the bottom line: not an official service. */
  note?: string;
}

const { support, tagline, groups, note } = Astro.props;
const path = Astro.url.pathname;
---

<footer class="page">
  {support && (
    <div class="support">
      <p>{support.text}</p>
      <Button href={support.href}>{support.label}</Button>
    </div>
  )}
  <div class="footer">
    <div class="about">
      <p class="name">
        <svg class="mark" viewBox="0 0 32 32" aria-hidden="true">
          <rect width="32" height="32" fill="var(--red)"></rect>
          <rect x="6" y="13" width="20" height="6" fill="var(--paper)"></rect>
          <rect x="13" y="6" width="6" height="20" fill="var(--paper)"></rect>
        </svg>
        Swiss Passport
      </p>
      {tagline && <p>{tagline}</p>}
    </div>
    {groups.map((g) => (
      <div class="group">
        {g.title && <h2>{g.title}</h2>}
        <ul>
          {g.links.map((l) => (
            <li>
              <a href={l.href} lang={l.lang} aria-current={ariaCurrent(l.href, path)}>
                {l.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))}
    <div class="bottom">
      <p>© 2026 Aleksej Dix</p>
      {note && <p class="note">{note}</p>}
    </div>
  </div>
</footer>

<style>
  .support {
    display: grid;
    grid-template-columns: var(--grid);
    column-gap: var(--gutter);
    justify-items: start;
    row-gap: var(--line);
    border-top: 1px solid var(--ink);
    padding-block: calc(var(--line) - 1px) calc(2 * var(--line));
  }
  .support > * {
    grid-column: 1 / -1;
  }
  .support > p {
    margin: 0;
    font-weight: 700;
  }
  @media (min-width: 40rem) {
    .support > * {
      grid-column: 4 / span 5;
    }
  }
  @media (min-width: 64rem) {
    .support > * {
      grid-column: 4 / span 6;
    }
  }
  .footer {
    display: grid;
    grid-template-columns: var(--grid);
    column-gap: var(--gutter);
    row-gap: var(--line);
    border-top: 1px solid var(--ink);
    padding-block: calc(var(--line) - 1px) calc(3 * var(--line));
    font-size: var(--xs);
    line-height: var(--xs-lh);
    letter-spacing: 0;
    color: var(--grey);
  }
  .about {
    grid-column: 1 / -1;
  }
  .about p + p {
    margin-top: 0.375rem;
  }
  .name {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 700;
    color: var(--ink);
  }
  .mark {
    width: var(--xs-lh);
    height: var(--xs-lh);
    flex: none;
  }
  /* Phones: the groups two by two. */
  .group {
    grid-column: span 2;
  }
  .group h2 {
    margin: 0 0 0.375rem;
    font-size: inherit;
    line-height: inherit;
    letter-spacing: inherit;
    font-weight: 700;
    color: var(--ink);
  }
  .group li + li {
    margin-top: 0.375rem;
  }
  .group a {
    color: var(--ink);
    text-decoration: none;
  }
  .group a:hover {
    color: var(--red);
  }
  .group a[aria-current] {
    font-weight: 700;
  }
  /* The bottom line spans the page, on its own hairline, in the columns of the rows above. */
  .bottom {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: subgrid;
    row-gap: 0.75rem;
    border-top: 1px solid var(--rule);
    padding-top: calc(var(--line) / 2 - 1px);
  }
  .bottom > p {
    grid-column: 1 / -1;
    margin: 0;
  }
  @media (min-width: 40rem) {
    .group:nth-child(2) {
      grid-column: 1 / span 4;
    }
    .group:nth-child(3) {
      grid-column: 5 / span 2;
    }
    .group:nth-child(4) {
      grid-column: 7 / span 2;
    }
    .bottom > p {
      grid-column: 1 / span 4;
    }
    .bottom > .note {
      grid-column: 5 / span 4;
    }
  }
  @media (min-width: 64rem) {
    .about {
      grid-column: 1 / span 3;
    }
    .group:nth-child(2) {
      grid-column: 4 / span 3;
    }
    .group:nth-child(3) {
      grid-column: 7 / span 3;
    }
    .group:nth-child(4) {
      grid-column: 10 / span 3;
    }
    .bottom > p {
      grid-column: 1 / span 3;
    }
    .bottom > .note {
      grid-column: 4 / span 6;
    }
  }
</style>
