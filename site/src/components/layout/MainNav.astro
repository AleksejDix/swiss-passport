---
// The pages of the site, in the masthead: one column on tablets, beside the name on wide screens.
import { questionsPath, guidePath, methodPath, connectPath, curriculumPath } from "../../data.ts";
import { texts } from "../../i18n.ts";

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const ui = texts(lang).site.ui;
const pages = [
  ["/learn/", texts(lang).site.home.nav_learn],
  [connectPath(lang), texts(lang).site.connect.nav],
  [questionsPath(lang), ui.nav_questions],
  [curriculumPath(lang), texts(lang).site.curriculum.nav],
  [guidePath(lang), texts(lang).site.guide.nav],
  [methodPath(lang), texts(lang).site.method.nav],
];
---

<nav class="nav" aria-label={ui.nav_main}>
  {pages.map(([href, name]) => (
    <a href={href}>{name}</a>
  ))}
</nav>

<style>
  .nav {
    display: flex;
    flex-wrap: wrap;
    column-gap: 1rem;
  }
  .nav a {
    text-decoration: none;
  }
  @media (min-width: 40rem) {
    .nav {
      grid-column: 1 / span 4;
      flex-direction: column;
    }
  }
  @media (min-width: 64rem) {
    .nav {
      grid-column: 4 / span 3;
    }
  }
</style>
