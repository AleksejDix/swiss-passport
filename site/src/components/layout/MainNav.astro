---
// The pages of the site, in the masthead: one column on tablets, beside the name on wide screens. The page the
// reader is on (or below, like a question below all questions) is set in bold and underlined in red.
import { menu, ariaCurrent } from "../../data.ts";
import { texts } from "../../i18n.ts";

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const path = Astro.url.pathname;
---

<nav class="nav" aria-label={texts(lang).site.ui.nav_main}>
  {menu(lang).map(({ href, label }) => (
    <a href={href} aria-current={ariaCurrent(href, path)}>
      {label}
    </a>
  ))}
</nav>

<style>
  .nav {
    display: flex;
    flex-wrap: wrap;
    column-gap: 1rem;
  }
  .nav a {
    text-decoration: none;
  }
  /* Where the reader is: bold like the current language, and the red of the flag as the signal. */
  .nav a[aria-current] {
    font-weight: 700;
    text-decoration: underline;
    text-decoration-color: var(--red);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.3em;
  }
  @media (min-width: 40rem) {
    .nav {
      grid-column: 1 / span 4;
      flex-direction: column;
    }
  }
  @media (min-width: 64rem) {
    .nav {
      grid-column: 4 / span 3;
    }
  }
</style>
