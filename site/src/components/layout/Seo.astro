---
// What search engines and link previews read: the canonical address, the page in the other languages,
// Open Graph and the structured data of the page.
import { SITE } from "../../site.ts";

interface Props {
  title: string;
  description: string;
  /** The address of this page, e.g. /de/method/. */
  path: string;
  /** This page in every language: { de: "/de/…", en: "/en/…" }. */
  alternates: Record<string, string>;
  /** The page for readers whose language is not offered (hreflang x-default). */
  xDefault?: string;
  /** og:locale; left out on pages in several languages. */
  locale?: string;
  /** The share image, e.g. /og/de.png (1200 × 630). */
  image: string;
  /** schema.org data for search engines. */
  jsonLd?: object;
}

const { title, description, path, alternates, xDefault, locale, image, jsonLd } = Astro.props;
const url = (p: string) => new URL(p, SITE).href;
---

<link rel="canonical" href={url(path)} />
{Object.entries(alternates).map(([id, p]) => (
  <link rel="alternate" hreflang={id} href={url(p)} />
))}
{xDefault && <link rel="alternate" hreflang="x-default" href={url(xDefault)} />}
<meta property="og:type" content="website" />
<meta property="og:site_name" content="Swiss Passport" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={url(path)} />
{locale && <meta property="og:locale" content={locale} />}
<meta property="og:image" content={url(image)} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta name="twitter:card" content="summary_large_image" />
<link rel="sitemap" href="/sitemap-index.xml" />
{jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
