---
// The curriculum map (issue #15): a unit per row. Phones and tablets: the unit's lessons as a list with their stage.
// Wide screens: the unit in the first two columns, then one pair of columns per stage. Stages come from requires in
// curriculum.json, the same rule the learning engine uses to offer lessons.
import { CURRICULUM, stageOf, lessonNumber } from "../../curriculum.ts";
import { TEXT, units, lessons, questionsPath, type Lesson } from "../../data.ts";

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const c = CURRICULUM[lang];
const t = TEXT[lang];
const byId = new Map(lessons.map((l) => [l.id, l]));
const stages = Math.max(...lessons.map((l) => stageOf(l.id))) + 1;
const list = new Intl.ListFormat(t.language, { type: "conjunction" });
const after = (l: Lesson) =>
  l.requires?.length
    ? c.after.replace(
        "{list}",
        list.format(l.requires.map((r) => c.lesson_ref.replace("{n}", String(lessonNumber(r))))),
      )
    : null;
---

<section class="cur" aria-label={c.map_label}>
  <div class="cur-head" aria-hidden="true">
    {Array.from({ length: stages }, (_, i) => (
      <span style={`--c:${3 + 2 * i}`}>{c.stage.replace("{n}", String(i + 1))}</span>
    ))}
  </div>
  {units.map((u) => (
    <div class="cur-unit">
      <h3>{t.units[u.id].title}</h3>
      <ol>
        {u.lessons.map((id) => {
          const l = byId.get(id)!;
          const stage = stageOf(id);
          return (
            <li style={`--c:${1 + 2 * stage}`}>
              <a href={`${questionsPath(lang)}#${id}`}>
                <b>{lessonNumber(id)}</b> {t.lessons[id].title}
              </a>
              <span class="small cur-stage">{c.stage.replace("{n}", String(stage + 1))}</span>
              {after(l) && <span class="small">{after(l)}</span>}
            </li>
          );
        })}
      </ol>
    </div>
  ))}
</section>

<style>
  .cur {
    padding-bottom: calc(3 * var(--line));
  }
  .cur-head {
    display: none;
  }
  .cur-unit {
    border-top: 1px solid var(--ink);
    padding-block: calc(var(--line) - 1px) var(--line);
  }
  .cur-unit h3 {
    margin-bottom: 0.75rem;
  }
  .cur-unit li {
    padding-block: 0.375rem;
    border-top: 1px solid var(--rule);
  }
  .cur-unit li a {
    display: block;
    text-decoration: none;
  }
  .cur-unit li a:hover {
    text-decoration: underline;
  }
  .cur-unit li b {
    font-variant-numeric: tabular-nums;
    margin-right: 0.25rem;
  }
  .cur-unit li .small {
    display: block;
  }

  @media (min-width: 64rem) {
    .cur-head,
    .cur-unit {
      display: grid;
      grid-template-columns: var(--grid);
      column-gap: var(--gutter);
    }
    .cur-head {
      font-size: var(--xs);
      line-height: var(--xs-lh);
      color: var(--grey);
      padding-bottom: 0.375rem;
    }
    .cur-head > span {
      grid-column: var(--c) / span 2;
    }
    .cur-unit h3 {
      grid-column: 1 / span 2;
      margin-bottom: 0;
    }
    .cur-unit ol {
      grid-column: 3 / -1;
      display: grid;
      grid-template-columns: subgrid;
      grid-auto-flow: dense;
      row-gap: 0.75rem;
      align-items: start;
    }
    /* Each lesson stands in the columns of its stage; lessons of one stage stack. */
    .cur-unit li {
      grid-column: var(--c) / span 2;
      border-top: 1px solid var(--rule);
    }
    /* The column already says the stage. */
    .cur-unit li .cur-stage {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }
</style>
