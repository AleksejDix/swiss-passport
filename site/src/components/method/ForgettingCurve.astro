---
// Schematic forgetting curve: all six repetitions in one evening vs spread out like the app (see src/viz/curve.js).
// The finished chart is in the HTML; scripts/method-viz.js draws it in and adds the day-by-day readout.
import Figure from "./Figure.astro";
import { DAYS, PLANS, W, H, PLOT, x, y, path, recall, level } from "../../viz/curve.ts";
import { texts } from "../../i18n.ts";

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const v = texts(lang).site.method_viz;
const pct = (n: number, of: number) => `${((100 * n) / of).toFixed(2)}%`;
const reviews = PLANS.spaced.reviews;
const ticks = [0, 10, 20, 30, 40, 50, 60];
const tableDays = [1, 7, 14, 30, 60];
const labels = { day: v.day, review: v.review, levels: v.levels, spaced: v.spacedShort, cram: v.cramShort };
---

<Figure class="curve" data-curve data-labels={JSON.stringify(labels)}>
  <figcaption class="viz-title">{v.curveTitle}</figcaption>
  <ul class="viz-legend">
    <li>
      <i class="key key-spaced"></i>
      {v.spaced}
    </li>
    <li>
      <i class="key key-cram"></i>
      {v.cram}
    </li>
  </ul>
  <div class="curve-plot" data-plot tabindex="0" role="img" aria-label={`${v.curveTitle}. ${v.curveNote}`}>
    <svg viewBox={`0 0 ${W} ${H}`} aria-hidden="true">
      <defs>
        <clipPath id="curve-reveal">
          <rect class="reveal" x="0" y="0" width={W} height={H} />
        </clipPath>
      </defs>
      <line class="grid" x1={PLOT.left} x2={PLOT.right} y1={y(1)} y2={y(1)} />
      <line class="grid" x1={PLOT.left} x2={PLOT.right} y1={y(0)} y2={y(0)} />
      {reviews.map((d) => (
        <line class="grid" x1={x(d)} x2={x(d)} y1={y(0)} y2={y(0) + 5} />
      ))}
      <g clip-path="url(#curve-reveal)">
        <path class="line line-cram" d={path("cram")} />
        <path class="line line-spaced" d={path("spaced")} />
      </g>
      {reviews.map((d) => (
        <circle class="dot" data-day={d} cx={x(d)} cy={y(1)} r="4.5" />
      ))}
      <line class="cross" data-cross x1="0" x2="0" y1={y(1) - 6} y2={y(0)} visibility="hidden" />
    </svg>
    <span class="ylab" style={`top:${pct(y(1), H)}`}>
      {v.all}
    </span>
    <span class="ylab" style={`top:${pct(y(0), H)}`}>
      {v.none}
    </span>
    <span class="direct" style={`right:0;top:${pct(y(recall("spaced", DAYS)) + 6, H)}`}>
      {v.spacedShort}
    </span>
    <span class="direct" style={`right:0;top:${pct(y(0.12), H)}`}>
      {v.cramShort}
    </span>
    <div class="viz-tip" data-tip hidden></div>
  </div>
  <div class="viz-axis" aria-hidden="true">
    {ticks.map((t, i) => (
      <span style={`left:${pct(x(t), W)}`} class={i === 0 ? "first" : i === ticks.length - 1 ? "last" : undefined}>
        {i === ticks.length - 1 ? `${t} ${v.days}` : t}
      </span>
    ))}
  </div>
  <p class="viz-note">{v.curveNote}</p>
  <details class="viz-table">
    <summary>{v.table}</summary>
    <table>
      <thead>
        <tr>
          <th scope="col">{v.day}</th>
          <th scope="col">{v.spacedShort}</th>
          <th scope="col">{v.cramShort}</th>
        </tr>
      </thead>
      <tbody>
        {tableDays.map((d) => (
          <tr>
            <th scope="row">{d}</th>
            <td>{v.levels[level(recall("spaced", d))]}</td>
            <td>{v.levels[level(recall("cram", d))]}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </details>
</Figure>

<style>
  /* Keys of the legend and of the readout (the readout is built by the script). */
  .curve :global(.key) {
    display: inline-block;
    width: 1rem;
    height: 2px;
    flex: none;
  }
  .curve :global(.key-spaced) {
    background: var(--red);
  }
  .curve :global(.key-cram) {
    background: var(--grey);
  }
  .curve-plot {
    position: relative;
    margin-top: var(--line);
    touch-action: pan-y;
    cursor: crosshair;
  }
  .curve-plot:focus-visible {
    outline-offset: 6px;
  }
  .curve-plot svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .curve .grid {
    stroke: var(--rule);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }
  .curve .line {
    fill: none;
    stroke-width: 2;
    stroke-linejoin: round;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
  }
  .curve .line-spaced {
    stroke: var(--red);
  }
  .curve .line-cram {
    stroke: var(--grey);
  }
  /* Review dots carry a ring in the paper colour so they stay clear where they sit on the line. */
  .curve .dot {
    fill: var(--red);
    stroke: var(--paper);
    stroke-width: 2;
    vector-effect: non-scaling-stroke;
    transform-box: fill-box;
    transform-origin: center;
  }
  .curve .cross {
    stroke: var(--ink);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }
  .curve .reveal {
    transform-box: fill-box;
    transform-origin: left;
  }
  .curve-plot .ylab,
  .curve-plot .direct {
    position: absolute;
    font-size: var(--xs);
    line-height: var(--xs-lh);
    color: var(--grey);
    pointer-events: none;
  }
  .curve-plot .ylab {
    left: 0;
    transform: translateY(-120%);
  }
  .curve-plot .direct {
    color: var(--ink);
    text-align: right;
  }
  .viz-axis {
    position: relative;
    height: var(--xs-lh);
    margin-top: 0.375rem;
    font-size: var(--xs);
    line-height: var(--xs-lh);
    color: var(--grey);
    font-variant-numeric: tabular-nums;
  }
  .viz-axis span {
    position: absolute;
    top: 0;
    transform: translateX(-50%);
    white-space: nowrap;
  }
  .viz-axis .first {
    transform: none;
  }
  .viz-axis .last {
    transform: translateX(-100%);
  }
  /* Phones: every second tick (0, 20, 40, 60), so the labels never touch. */
  @media (max-width: 39.99rem) {
    .viz-axis span:nth-child(even) {
      display: none;
    }
  }
  .viz-tip {
    position: absolute;
    top: calc(-1 * var(--line));
    z-index: 1;
    min-width: 11rem;
    padding: 0.5rem 0.625rem;
    background: var(--paper);
    border: 1px solid var(--ink);
    font-size: var(--xs);
    line-height: var(--xs-lh);
    pointer-events: none;
  }
  .viz-tip :global(p) {
    display: flex;
    align-items: center;
    gap: 0.375rem;
  }
  .viz-tip :global(.tip-day) {
    color: var(--grey);
  }
  .viz-tip :global(span) {
    color: var(--grey);
  }
  .viz-table {
    margin-top: 0.375rem;
    font-size: var(--xs);
    line-height: var(--xs-lh);
  }
  .viz-table summary {
    cursor: pointer;
    color: var(--grey);
  }
  .viz-table table {
    border-collapse: collapse;
    margin-top: 0.375rem;
    font-variant-numeric: tabular-nums;
  }
  .viz-table :is(th, td) {
    text-align: left;
    padding: 0.1875rem 1.25rem 0.1875rem 0;
    border-top: 1px solid var(--rule);
    font-weight: 400;
  }
  .viz-table thead th {
    border-top: 0;
    color: var(--grey);
  }
</style>
