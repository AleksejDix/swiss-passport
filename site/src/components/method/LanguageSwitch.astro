---
// One exam question with a language switch; the German wording of the real test stays visible.
// All six translations are in the page; scripts/method-viz.js swaps them.
import Figure from "./Figure.astro";
import Toggle from "./Toggle.astro";
import AnswerList from "../ui/AnswerList.svelte";
import AnswerRow from "../ui/AnswerRow.svelte";
import Prompt from "../ui/Prompt.astro";
import { VIZ } from "../../method.ts";
import { LANGS } from "../../scripts/i18n.ts";
import { TEXT, question } from "../../data.ts";

interface Props {
  lang: string;
  /** The question, e.g. q055. */
  id: string;
}

const { lang, id } = Astro.props;
const v = VIZ[lang];
const q = question(id);
const letters = q.options.map((o) => o.id);
const texts = Object.fromEntries(
  Object.keys(LANGS).map((l) => [l, { q: TEXT[l].questions[id].question, o: TEXT[l].questions[id].options }]),
);
const t = texts[lang];
const de = texts.de;
---

<Figure class="langs" data-langswitch data-texts={JSON.stringify(texts)}>
  <Toggle
    label={v.showIn}
    name="lang-choice"
    pressed={lang}
    choices={Object.entries(LANGS).map(([l, name]) => ({ value: l, label: name, lang: l }))}
  />
  <Prompt question={t.q} lang={lang} german={de.q} germanHidden={lang === "de"} switchable />
  <AnswerList>
    {letters.map((l) => (
      <AnswerRow letter={l} right={l === q.answer}>
        <span data-o={l} lang={lang}>
          {t.o[l]}
        </span>
        <small lang="de" data-o-de hidden={lang === "de"}>
          {de.o[l]}
        </small>
      </AnswerRow>
    ))}
  </AnswerList>
</Figure>

<style>
  .langs :global(.answers) {
    margin-top: var(--line);
  }
</style>
