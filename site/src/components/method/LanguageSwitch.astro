---
// One exam question with a language switch; the German wording of the real test stays visible.
// All six translations are in the page; scripts/method-viz.js swaps them.
import Figure from "./Figure.astro";
import Toggle from "./Toggle.astro";
import AnswerList from "../ui/AnswerList.svelte";
import AnswerRow from "../ui/AnswerRow.svelte";
import Prompt from "../ui/Prompt.astro";
import { question } from "../../data.ts";
import { texts, LANGUAGE_NAMES } from "../../i18n.ts";

interface Props {
  lang: string;
  /** The question, e.g. q055. */
  id: string;
}

const { lang, id } = Astro.props;
const v = texts(lang).site.method_viz;
const q = question(id);
const letters = q.options.map((o) => o.id);
// The question in every language, for the switch.
const translations = Object.fromEntries(
  Object.keys(LANGUAGE_NAMES).map((l) => [
    l,
    { q: texts(l).questions[id].question, o: texts(l).questions[id].options },
  ]),
);
const t = translations[lang];
const de = translations.de;
---

<Figure class="langs" data-langswitch data-texts={JSON.stringify(translations)}>
  <Toggle
    label={v.showIn}
    name="lang-choice"
    pressed={lang}
    choices={Object.entries(LANGUAGE_NAMES).map(([l, name]) => ({ value: l, label: name, lang: l }))}
  />
  <Prompt question={t.q} lang={lang} german={de.q} germanHidden={lang === "de"} switchable />
  <AnswerList>
    {letters.map((l) => (
      <AnswerRow letter={l} right={l === q.answer}>
        <span data-o={l} lang={lang}>
          {t.o[l]}
        </span>
        <small lang="de" data-o-de hidden={lang === "de"}>
          {de.o[l]}
        </small>
      </AnswerRow>
    ))}
  </AnswerList>
</Figure>

<style>
  .langs :global(.answers) {
    margin-top: var(--line);
  }
</style>
