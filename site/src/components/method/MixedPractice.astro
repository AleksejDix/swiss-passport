---
// Twelve questions from three topics, first in blocks, then mixed like in the test.
// Topics differ by shape (circle, square, triangle), not by colour. scripts/method-viz.js reorders them.
import Figure from "./Figure.astro";
import Toggle from "./Toggle.astro";
import { VIZ } from "../../method.ts";
import { TEXT } from "../../data.ts";

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const v = VIZ[lang];
const TOPICS = [
  { id: "democracy", shape: "circle" },
  { id: "history", shape: "square" },
  { id: "geography", shape: "triangle" },
];
// Item i belongs to topic floor(i / 4). Mixed: every topic four times, never twice in a row.
const MIXED = [0, 4, 8, 1, 9, 5, 2, 6, 10, 3, 7, 11];
const items = Array.from({ length: 12 }, (_, i) => TOPICS[Math.floor(i / 4)]);
const name = (topic: { id: string }) => TEXT[lang].categories[topic.id];
---

<Figure class="mix" data-mix data-mixed={JSON.stringify(MIXED)}>
  <Toggle
    label={v.order}
    name="order"
    pressed="blocked"
    choices={[
      { value: "blocked", label: v.blocked },
      { value: "mixed", label: v.mixed },
    ]}
  />
  <ol class="mix-row" data-row>
    {items.map((topic, i) => (
      <li data-item={i} class={`shape shape-${topic.shape}`} title={name(topic)}>
        <span class="visually-hidden">{name(topic)}</span>
      </li>
    ))}
  </ol>
  <ul class="viz-legend">
    {TOPICS.map((topic) => (
      <li>
        <i class={`shape shape-${topic.shape}`}></i>
        {name(topic)}
      </li>
    ))}
  </ul>
  <p class="viz-note">{v.mixNote}</p>
</Figure>

<style>
  /* Topics by shape, not by colour. */
  .mix-row {
    display: flex;
    align-items: flex-start;
    gap: 0.375rem;
    margin-top: var(--line);
  }
  .mix-row li {
    flex: 1 1 0;
    max-width: 2.25rem;
    aspect-ratio: 1;
  }
  .shape {
    display: inline-block;
    background: var(--ink);
  }
  .viz-legend .shape {
    width: 0.75rem;
    height: 0.75rem;
    flex: none;
  }
  .shape-circle {
    border-radius: 50%;
  }
  .shape-triangle {
    clip-path: polygon(50% 4%, 100% 96%, 0 96%);
  }
  .mix .viz-legend {
    margin-top: 0.75rem;
  }
</style>
