---
// Learn online: the browser client for the MCP tools. One URL for all languages; learn.js picks the language.
import Document from "../../layouts/Document.astro";
import Masthead from "../../components/layout/Masthead.astro";
import Brand from "../../components/layout/Brand.astro";
import LanguageNav from "../../components/layout/LanguageNav.astro";
import Footer from "../../components/layout/Footer.astro";
import "../../styles/styles.css";
import "../../styles/learn.css";
import { SITE } from "../../site.ts";
import { LANGS } from "../../scripts/i18n.ts";
import { byLang } from "../../../../i18n/index.js";

// The interface texts of every language (i18n/<code>.json, key learn), for learn.js to switch without reloading.
const TEXT = byLang((t) => ({ name: t.name, ...t.learn }));

// Chrome origin trial: turns on WebMCP (the page tools in learn.js) for https://swiss-passport.com
// in Chrome 149 to 156. Expires 17 November 2026; renew at https://developer.chrome.com/origintrials/.
const WEBMCP_TRIAL =
  "Ah7vqevf8D3IVPeMj+zJrDK0DW9H1YhsqvNHCXPYqtBuaMnmHmLWf3KCrF/2VwL0uVxX270c/pmvrYpkOtYMWwwAAABSeyJvcmlnaW4iOiJodHRwczovL3N3aXNzLXBhc3Nwb3J0LmNvbTo0NDMiLCJmZWF0dXJlIjoiV2ViTUNQIiwiZXhwaXJ5IjoxNzk0ODczNjAwfQ==";
---

<Document
  lang="en"
  title="Learn online: Swiss Passport"
  description={`Practise the 350 official questions of the Zurich naturalisation knowledge test in your browser, in ${Object.keys(LANGS).length} languages.`}
  bodyClass="learn"
>
  <Fragment slot="head">
    <link rel="canonical" href={new URL("/learn/", SITE).href} />
    <meta http-equiv="origin-trial" content={WEBMCP_TRIAL} />
  </Fragment>

  <Masthead>
    <Brand href="/" label="Swiss Passport, home" />
    <!-- Rendered here so the header has its final height before learn.js marks the chosen language. -->
    <LanguageNav label="Language" buttons />
  </Masthead>
  <main class="page app" data-app data-text={JSON.stringify(TEXT)}>
    <p class="small">Loading…</p>
  </main>
  <noscript>
    <p class="page">This page needs JavaScript.</p>
  </noscript>
  <Footer
    links={[
      { href: "/impressum/", label: "Impressum", lang: "de" },
      { href: "/datenschutz/", label: "Datenschutz", lang: "de" },
    ]}
  />
  <script>
    import "../../scripts/learn.js";
  </script>
</Document>
