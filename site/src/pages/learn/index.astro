---
// Learn online: the browser client for the MCP tools. One URL for all languages; learn.js picks the language.
// The font is served from this site, not from Google.
import "@fontsource-variable/inter/opsz.css";
import "../../styles/styles.css";
import "../../styles/learn.css";
import { SITE } from "../../site.js";
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Learn online: Swiss Passport</title>
<meta name="description" content="Practise the 350 official questions of the Zurich naturalisation knowledge test in your browser, in six languages.">
<link rel="canonical" href={new URL("/learn/", SITE).href}>
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
</head>
<body class="learn">
<header class="page masthead">
  <a class="brand" href="/" aria-label="Swiss Passport, home">
    <svg class="mark" viewBox="0 0 32 32" aria-hidden="true">
      <rect width="32" height="32" fill="var(--red)"/>
      <rect x="6" y="13" width="20" height="6" fill="#fff"/>
      <rect x="13" y="6" width="6" height="20" fill="#fff"/>
    </svg>
    <span>Swiss Passport</span>
  </a>
  <nav class="langs-nav" aria-label="Language" data-langs></nav>
</header>
<main class="page app" data-app aria-live="polite">
  <p class="small">Loading…</p>
</main>
<noscript><p class="page">This page needs JavaScript.</p></noscript>
<footer class="page"><div class="footer"><p><a href="/impressum/">Impressum</a> <a href="/datenschutz/">Datenschutz</a></p></div></footer>
<script>
  import "../../scripts/learn.js";
</script>
</body>
</html>
