---
// Language picker at /. No language is the default: the learner picks one, and the choice is remembered.
import Document from "../layouts/Document.astro";
import Seo from "../components/layout/Seo.astro";
import Masthead from "../components/layout/Masthead.astro";
import Brand from "../components/layout/Brand.astro";
import Footer from "../components/layout/Footer.astro";
import { homePath } from "../data.ts";
import { texts, LANGUAGE_NAMES } from "../i18n.ts";

const title = "Swiss Passport: Einbürgerungstest Zürich · Zurich citizenship test";
const n = Object.keys(LANGUAGE_NAMES).length;
const description = `Lernen für den Einbürgerungstest im Kanton Zürich, in ${n} Sprachen. Learn for the Zurich citizenship test in ${n} languages.`;
const alternates = Object.fromEntries(Object.keys(LANGUAGE_NAMES).map((id) => [id, homePath(id)]));
---

<Document lang="mul" title={title} description={description} cyrillic>
  <Fragment slot="head">
    <Seo title={title} description={description} path="/" alternates={alternates} xDefault="/" image="/og/de.png" />
    <script is:inline define:vars={{ langs: Object.keys(LANGUAGE_NAMES) }}>
      // Someone who already picked a language goes straight to it.
      try {
        const saved = localStorage.getItem("sp-lang");
        if (langs.includes(saved)) location.replace(`/${saved}/`);
      } catch {
        /* storage unavailable */
      }
    </script>
  </Fragment>

  <Masthead>
    <Brand />
  </Masthead>

  <main class="page">
    <nav class="picker" aria-label="Language / Sprache">
      {Object.entries(LANGUAGE_NAMES).map(([id, name]) => (
        <a href={homePath(id)} hreflang={id} lang={id} data-lang={id}>
          <span class="picker-name">{name}</span>
          <span class="picker-line">{texts(id).site.home.h1}</span>
        </a>
      ))}
    </nav>
  </main>

  <Footer
    links={[
      { href: "/impressum/", label: "Impressum", lang: "de" },
      { href: "/datenschutz/", label: "Datenschutz", lang: "de" },
      { href: "https://github.com/AleksejDix/swiss-passport", label: "GitHub" },
    ]}
  />
  <script is:inline>
    for (const a of document.querySelectorAll("[data-lang]")) {
      a.addEventListener("click", () => {
        try {
          localStorage.setItem("sp-lang", a.dataset.lang);
        } catch {}
      });
    }
  </script>
</Document>

<style>
  /* Six languages, set as large as the page allows. */
  .picker {
    display: grid;
    padding-bottom: calc(3 * var(--line));
  }
  .picker a {
    display: grid;
    grid-template-columns: var(--grid);
    column-gap: var(--gutter);
    row-gap: 0.375rem;
    align-items: last baseline;
    padding-block: 0.75rem calc(var(--line) - 1px);
    border-top: 1px solid var(--ink);
    text-decoration: none;
  }
  .picker a:last-child {
    border-bottom: 1px solid var(--ink);
  }
  .picker a > * {
    grid-column: 1 / -1;
  }
  .picker-name {
    font-size: var(--xxl);
    line-height: 0.94;
    font-weight: 700;
    letter-spacing: var(--xxl-track);
    margin-inline-start: -0.054em;
  }
  .picker-line {
    color: var(--grey);
  }
  .picker a:hover {
    color: var(--red);
  }
  .picker a:hover .picker-line {
    color: var(--ink);
  }
  @media (min-width: 64rem) {
    .picker a > .picker-name {
      grid-column: 1 / span 6;
    }
    .picker a > .picker-line {
      grid-column: 7 / span 5;
    }
  }
  /* Display leading snaps to the 6px unit. */
  @supports (line-height: round(1em, 1px)) {
    .picker-name {
      line-height: round(0.94em, 0.375rem);
    }
  }
</style>
