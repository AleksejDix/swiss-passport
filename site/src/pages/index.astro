---
// Language picker at /. No language is the default: the learner picks one, and the choice is remembered.
import "@fontsource/golos-text/400.css";
import "@fontsource/golos-text/600.css";
import "../styles/styles.css";
import { SITE } from "../site.js";
import { LANGS, STRINGS } from "../scripts/i18n.js";
import { homePath } from "../data.js";

const title = "Swiss Passport: Einbürgerungstest Zürich · Zurich citizenship test";
const description = "Lernen für den Einbürgerungstest im Kanton Zürich, in sechs Sprachen. Learn for the Zurich citizenship test in six languages.";
const url = (path) => new URL(path, SITE).href;
---
<!doctype html>
<html lang="mul">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title>
<meta name="description" content={description}>
<link rel="canonical" href={url("/")}>
{Object.keys(LANGS).map((id) => <link rel="alternate" hreflang={id} href={url(homePath(id))}>)}
<link rel="alternate" hreflang="x-default" href={url("/")}>
<meta property="og:type" content="website">
<meta property="og:site_name" content="Swiss Passport">
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:url" content={url("/")}>
<meta property="og:image" content={url("/og/de.png")}>
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta name="twitter:card" content="summary_large_image">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="sitemap" href="/sitemap-index.xml">
<script is:inline define:vars={{ langs: Object.keys(LANGS) }}>
  // Someone who already picked a language goes straight to it.
  try {
    const saved = localStorage.getItem("sp-lang");
    if (langs.includes(saved)) location.replace(`/${saved}/`);
  } catch { /* storage unavailable */ }
</script>
</head>
<body>
<header class="page masthead">
  <span class="brand">
    <svg class="mark" viewBox="0 0 32 32" aria-hidden="true">
      <rect width="32" height="32" fill="var(--red)"/>
      <rect x="6" y="13" width="20" height="6" fill="#fff"/>
      <rect x="13" y="6" width="6" height="20" fill="#fff"/>
    </svg>
    <span>Swiss Passport</span>
  </span>
</header>

<main class="page">
  <nav class="picker" aria-label="Language / Sprache">
    {Object.entries(LANGS).map(([id, name]) => (
      <a href={homePath(id)} hreflang={id} lang={id} data-lang={id}>
        <span class="picker-name">{name}</span>
        <span class="picker-line">{STRINGS[id].h1}</span>
      </a>
    ))}
  </nav>
</main>

<footer class="page">
  <div class="footer">
  <p><a href="/impressum/">Impressum</a> <a href="/datenschutz/">Datenschutz</a> <a href="https://github.com/AleksejDix/swiss-passport">GitHub</a></p>
  </div>
</footer>
<script is:inline>
  for (const a of document.querySelectorAll("[data-lang]")) {
    a.addEventListener("click", () => { try { localStorage.setItem("sp-lang", a.dataset.lang); } catch {} });
  }
</script>
</body>
</html>
