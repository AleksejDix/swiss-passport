---
// The page for addresses that do not exist (Cloudflare serves it with status 404). No language is known,
// so it says so in every language and links to each language's questions and home page.
import Document from "../layouts/Document.astro";
import Masthead from "../components/layout/Masthead.astro";
import Brand from "../components/layout/Brand.astro";
import "../styles/styles.css";
import { LANGS } from "../scripts/i18n.ts";
import { UI } from "../ui.ts";
import { homePath, questionsPath } from "../data.ts";
import { byLang } from "../../../i18n/index.js";

const MISSING = byLang((t) => t.site.not_found);
---

<Document lang="mul" title="404 | Swiss Passport" noindex>
  <Masthead>
    <Brand href="/" />
  </Masthead>

  <main class="page">
    <header class="qhead">
      <h1>404</h1>
    </header>
    {Object.keys(LANGS).map((id) => (
      <section class="row" lang={id}>
        <h2>{MISSING[id]}</h2>
        <p class="links">
          <a href={questionsPath(id)}>{UI[id].nav_questions}</a> <a href={homePath(id)}>{UI[id].home}</a>
        </p>
      </section>
    ))}
  </main>
</Document>
