---
// The page for addresses that do not exist (Cloudflare serves it with status 404). No language is known,
// so it says so in every language and links to each language's questions and home page.
import Document from "../layouts/Document.astro";
import Masthead from "../components/layout/Masthead.astro";
import Brand from "../components/layout/Brand.astro";
import PageHead from "../components/ui/PageHead.astro";
import Section from "../components/ui/Section.astro";
import { homePath, questionsPath } from "../data.ts";
import { texts, LANGUAGE_NAMES } from "../i18n.ts";
---

<Document lang="mul" title="404 | Swiss Passport" noindex>
  <Masthead>
    <Brand href="/" />
  </Masthead>

  <main class="page">
    <PageHead title="404" />
    {Object.keys(LANGUAGE_NAMES).map((id) => (
      <Section title={texts(id).site.not_found} lang={id}>
        <p class="links">
          <a href={questionsPath(id)}>{texts(id).site.ui.nav_questions}</a>{" "}
          <a href={homePath(id)}>{texts(id).site.ui.home}</a>
        </p>
      </Section>
    ))}
  </main>
</Document>

<style>
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem var(--gutter);
    align-items: baseline;
  }
</style>
