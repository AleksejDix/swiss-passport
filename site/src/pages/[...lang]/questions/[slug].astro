---
// One page per official question and language: the question, the correct answer, why, and the German original.
import Base from "../../../layouts/Base.astro";
import { UI } from "../../../ui.js";
import { TEXT, LANG_IDS, lessons, questions, questionPath, questionsPath } from "../../../data.js";

export function getStaticPaths() {
  return LANG_IDS.flatMap((lang) =>
    questions.map((q, i) => ({
      params: { lang: lang === "en" ? undefined : lang, slug: q.slug },
      props: { lang, q, prev: questions[i - 1], next: questions[i + 1] },
    })),
  );
}

const { lang, q, prev, next } = Astro.props;
const ui = UI[lang];
const t = TEXT[lang];
const text = t.questions[q.id];
const de = TEXT.de.questions[q.id];
const letters = q.options.map((o) => o.id);
const right = q.answer;
const concept = t.concepts[q.concept.id];
const lesson = t.lessons[q.lesson];
const unit = lessons.find((l) => l.id === q.lesson).unit;
const img = (path) => `/${path}`;

const title = `${text.question} | ${ui.title_suffix}`;
const description = `${ui.answer}: ${right.toUpperCase()}, ${text.options[right]}. ${text.why}`.slice(0, 300);
const alternates = Object.fromEntries(LANG_IDS.map((id) => [id, questionPath(id, q)]));

// schema.org Quiz with one multiple choice question (Google "Education Q&A").
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Quiz",
  inLanguage: lang,
  about: { "@type": "Thing", name: t.title },
  educationalLevel: "Grundkenntnistest Kanton Zürich",
  hasPart: [{
    "@type": "Question",
    eduQuestionType: "Multiple choice",
    learningResourceType: "Practice problem",
    name: text.question,
    text: text.question,
    suggestedAnswer: letters.filter((l) => l !== right).map((l) => ({
      "@type": "Answer", position: letters.indexOf(l), text: text.options[l],
    })),
    acceptedAnswer: {
      "@type": "Answer", position: letters.indexOf(right), text: text.options[right],
      answerExplanation: { "@type": "Comment", text: text.why },
    },
  }],
};
---
<Base lang={lang} title={title} description={description} alternates={alternates} jsonLd={jsonLd}>
<main class="page question">
  <header class="qhead">
    <p class="small">{ui.question_n.replace("{n}", q.n)} · <a href={`${questionsPath(lang)}#${q.lesson}`}>{lesson.title}</a></p>
    <h1>{text.question}</h1>
    {lang !== "de" && <p class="qde" lang="de">{de.question}</p>}
    {q.image && <img class="qpicture" src={img(q.image)} alt={text.question} loading="lazy">}
  </header>

  <section class="row" aria-labelledby="answer">
    <h2 id="answer">{ui.answer}: {right.toUpperCase()}</h2>
    <ol class="qoptions">
      {q.options.map((o) => (
        <li class={o.id === right ? "is-right" : undefined}>
          <b>{o.id.toUpperCase()}</b>
          <span>
            {o.image && <img src={img(o.image)} alt={text.options[o.id]} loading="lazy">}
            {text.options[o.id]}{lang !== "de" && <small lang="de">{de.options[o.id]}</small>}
          </span>
        </li>
      ))}
    </ol>
  </section>

  <section class="row" aria-labelledby="why">
    <h2 id="why">{ui.why}</h2>
    <div>
      <p>{text.why}</p>
      {text.distractors && Object.keys(text.distractors).length > 0 && (
        <>
          <h3>{ui.mistakes}</h3>
          <dl class="mistakes">
            {Object.entries(text.distractors).map(([l, why]) => (
              <>
                <dt>{l.toUpperCase()}: {text.options[l]}</dt>
                <dd>{why}</dd>
              </>
            ))}
          </dl>
        </>
      )}
    </div>
  </section>

  <section class="row" aria-labelledby="topic">
    <h2 id="topic">{ui.topic}</h2>
    <div>
      <p><strong>{concept.title}</strong></p>
      <p class="small">{t.units[unit].title} · {lesson.title}</p>
      {q.concept.sources?.length > 0 && (
        <>
          <h3>{ui.sources}</h3>
          <ul class="sources">
            {q.concept.sources.map((src) => <li><a href={src} rel="noopener">{new URL(src).hostname.replace(/^www\./, "")}</a></li>)}
          </ul>
        </>
      )}
      <p class="note">{ui.credit}</p>
    </div>
  </section>

  <nav class="row qnav" aria-label={ui.nav_questions}>
    <p class="cta"><a class="button" href="/learn/">{ui.practise}</a></p>
    <p>
      {prev && <a rel="prev" href={questionPath(lang, prev)}>← {ui.prev}</a>}
      {next && <a rel="next" href={questionPath(lang, next)}>{ui.next} →</a>}
      <a href={questionsPath(lang)}>{ui.nav_questions}</a>
    </p>
  </nav>
</main>
</Base>
