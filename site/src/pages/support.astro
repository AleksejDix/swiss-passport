---
// Support in English, for readers and app directories (ChatGPT, Claude): contact and the common problems.
import Base from "../layouts/Base.astro";
import { OPERATOR } from "../legal.js";
import { connectPath } from "../data.js";

const sections = [
  ["Contact", [
    `Email: <a href="mailto:${OPERATOR.email}">${OPERATOR.email}</a>. Swiss Passport is a private project; we answer as soon as we can, usually within a few days.`,
    'Found a mistake in a question, an explanation or a translation? Report it on <a href="https://github.com/AleksejDix/swiss-passport/issues">GitHub</a> or by email, with the question number.',
  ]],
  ["Setting it up", [
    `Step by step for Claude, ChatGPT, Grok, Mistral Vibe and Perplexity: <a href="${connectPath("en")}">Swiss Passport in your AI app</a>. The server address is https://swiss-passport.com/mcp, without authentication.`,
  ]],
  ["The app looks old or does not answer", [
    "In ChatGPT: Settings → Plugins → Swiss Passport → Refresh tools, then start a new chat. In Claude: turn the connector off and on again under + → Connectors. Older chats keep the old quiz card.",
  ]],
  ["Lost learner code", [
    "There are no accounts, so a lost code cannot be recovered. Start again without a code and you get a new one.",
  ]],
  ["Deleting your progress", [
    "Write to the email address above with your learner code and we delete it. Otherwise it is deleted automatically 12 months after your last activity.",
  ]],
  ["Legal", [
    '<a href="/terms/">Terms of use</a>, <a href="/privacy/">privacy policy</a>, <a href="/impressum/" hreflang="de" lang="de">Impressum</a>.',
  ]],
];
---
<Base lang="en" remember={false} title="Support | Swiss Passport" description="Help and contact for Swiss Passport: setup in AI apps, lost learner codes, deleting your progress, reporting mistakes." alternates={{ en: "/support/" }}>
<main class="page">
  <header class="qhead">
    <h1>Support</h1>
  </header>
  {sections.map(([heading, paragraphs], i) => (
    <section class="row" aria-labelledby={`s${i}`}>
      <h2 id={`s${i}`}>{heading}</h2>
      <div class="prose">{paragraphs.map((html) => <p set:html={html} />)}</div>
    </section>
  ))}
</main>
</Base>
