---
import type { InferGetStaticPropsType } from "astro";
// The test guide: who takes the Grundkenntnistest, which questions, where, and what it costs. Official facts only.
import Base from "../../../layouts/Base.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import SelfCheck from "../../../components/guide/SelfCheck.astro";
import TestOrder from "../../../components/guide/TestOrder.astro";
import { UI } from "../../../ui.ts";
import { GUIDE, LINKS } from "../../../guide.ts";
import { LANG_IDS, guidePath, questionsPath, methodPath } from "../../../data.ts";

export function getStaticPaths() {
  return LANG_IDS.map((lang) => ({ params: { lang }, props: { lang } }));
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { lang } = Astro.props;
const g = GUIDE[lang];
const ui = UI[lang];
const links = { ...LINKS, questions: questionsPath(lang), learn: "/learn/", method: methodPath(lang) };
const fill = (html: string) => html.replace(/\{(\w+)\}/g, (_, k: string) => (links as Record<string, string>)[k]);
const plain = (html: string) => html.replace(/<li>/g, " ").replace(/<[^>]+>/g, "").replace(/\s+/g, " ").trim();
const alternates = Object.fromEntries(LANG_IDS.map((id) => [id, guidePath(id)]));
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  inLanguage: lang,
  mainEntity: g.faq.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: plain(f.a.join(" ")) },
  })),
};
const sources = [
  ["zh.ch: Grundkenntnistest", LINKS.zh],
  ["zh.ch: Grundkenntnistest Kanton Zürich (PDF)", LINKS.pdf],
  ["stadt-zuerich.ch: Grundkenntnisse", LINKS.city],
  ["zh.ch: KBüV (LS 141.11)", LINKS.kbuev],
];
---
<Base lang={lang} title={g.title} description={g.desc} alternates={alternates} jsonLd={jsonLd}>
<main class="page">
  <header class="qhead">
    <Breadcrumbs lang={lang} items={[[g.nav, guidePath(lang)]]} />
    <h1>{g.title}</h1>
    <p class="lede">{g.lede}</p>
  </header>

  {g.faq.map((f, i) => (
    <section class="row" aria-labelledby={`f${i}`}>
      <h2 id={`f${i}`}>{f.q}</h2>
      <div class="prose">
        {f.a.map((html) => (html.startsWith("<ul>") ? <Fragment set:html={fill(html)} /> : <p set:html={fill(html)} />))}
        {i === 1 && <SelfCheck lang={lang} />}
        {i === 3 && <TestOrder lang={lang} />}
      </div>
    </section>
  ))}

  <section class="row" aria-labelledby="sources">
    <h2 id="sources">{g.sources}</h2>
    <div>
      <ul class="sources">
        {sources.map(([name, href]) => <li><a href={href} rel="noopener">{name}</a></li>)}
      </ul>
      <p class="note">{g.disclaimer}</p>
    </div>
  </section>

  <nav class="row qnav" aria-label={g.nav}>
    <p class="cta"><a class="button" href="/learn/">{ui.practise}</a></p>
    <p><a href={questionsPath(lang)}>{ui.nav_questions}</a></p>
  </nav>
</main>
</Base>

<script>
  import "../../../scripts/self-check.js";
</script>
