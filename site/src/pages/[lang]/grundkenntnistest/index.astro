---
import type { InferGetStaticPropsType } from "astro";
// The test guide: who takes the Grundkenntnistest, which questions, where, and what it costs. Official facts only.
import Base from "../../../layouts/Base.astro";
import PageHead from "../../../components/ui/PageHead.astro";
import Section from "../../../components/ui/Section.astro";
import Prose from "../../../components/ui/Prose.astro";
import Sources from "../../../components/ui/Sources.astro";
import PageNav from "../../../components/ui/PageNav.astro";
import SelfCheck from "../../../components/guide/SelfCheck.astro";
import TestOrder from "../../../components/guide/TestOrder.astro";
import { UI } from "../../../ui.ts";
import { GUIDE, LINKS } from "../../../guide.ts";
import { LANG_IDS, guidePath, questionsPath, methodPath } from "../../../data.ts";

export function getStaticPaths() {
  return LANG_IDS.map((lang) => ({ params: { lang }, props: { lang } }));
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { lang } = Astro.props;
const g = GUIDE[lang];
const ui = UI[lang];
const links = { ...LINKS, questions: questionsPath(lang), learn: "/learn/", method: methodPath(lang) };
const fill = (html: string) => html.replace(/\{(\w+)\}/g, (_, k: string) => (links as Record<string, string>)[k]);
const plain = (html: string) =>
  html
    .replace(/<li>/g, " ")
    .replace(/<[^>]+>/g, "")
    .replace(/\s+/g, " ")
    .trim();
const alternates = Object.fromEntries(LANG_IDS.map((id) => [id, guidePath(id)]));
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  inLanguage: lang,
  mainEntity: g.faq.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: plain(f.a.join(" ")) },
  })),
};
const sources = [
  ["zh.ch: Grundkenntnistest", LINKS.zh],
  ["zh.ch: Grundkenntnistest Kanton Zürich (PDF)", LINKS.pdf],
  ["stadt-zuerich.ch: Grundkenntnisse", LINKS.city],
  ["zh.ch: KBüV (LS 141.11)", LINKS.kbuev],
];
---

<Base lang={lang} title={g.title} description={g.desc} alternates={alternates} jsonLd={jsonLd}>
  <main class="page">
    <PageHead title={g.title} lede={g.lede} lang={lang} crumbs={[[g.nav, guidePath(lang)]]} />

    {g.faq.map((f, i) => (
      <Section title={f.q} id={`f${i}`}>
        <Prose>
          {f.a.map((html) =>
            html.startsWith("<ul>") ? <Fragment set:html={fill(html)} /> : <p set:html={fill(html)} />,
          )}
          {i === 1 && <SelfCheck lang={lang} />}
          {i === 3 && <TestOrder lang={lang} />}
        </Prose>
      </Section>
    ))}

    <Section title={g.sources} id="sources">
      <div>
        <Sources items={sources.map(([name, href]) => ({ href, label: name }))} />
        <p class="note">{g.disclaimer}</p>
      </div>
    </Section>

    <PageNav label={g.nav} action={ui.practise} links={[{ href: questionsPath(lang), label: ui.nav_questions }]} />
  </main>
</Base>

<script>
  import "../../../scripts/self-check.js";
</script>
