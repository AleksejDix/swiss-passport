---
import type { InferGetStaticPropsType } from "astro";
// Adding Swiss Passport to an AI app: the MCP address, then numbered steps per app (texts in connect.js).
import Base from "../../../layouts/Base.astro";
import AppLinks from "../../../components/ui/AppLinks.astro";
import CopyUrl from "../../../components/ui/CopyUrl.astro";
import Logo from "../../../components/ui/Logo.astro";
import PageHead from "../../../components/ui/PageHead.astro";
import Section from "../../../components/ui/Section.astro";
import { CONNECT } from "../../../connect.ts";
import { STRINGS } from "../../../scripts/i18n.ts";
import { SITE } from "../../../site.ts";
import { LANG_IDS, connectPath } from "../../../data.ts";

export function getStaticPaths() {
  return LANG_IDS.map((lang) => ({ params: { lang }, props: { lang } }));
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { lang } = Astro.props;
const c = CONNECT[lang];
const s = STRINGS[lang];
const alternates = Object.fromEntries(LANG_IDS.map((id) => [id, connectPath(id)]));
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "HowTo",
  name: c.title,
  description: c.desc,
  inLanguage: lang,
  url: new URL(connectPath(lang), SITE).href,
  step: c.apps.map((app) => ({
    "@type": "HowToSection",
    name: app.name,
    itemListElement: app.steps.map((text) => ({ "@type": "HowToStep", text })),
  })),
};
---

<Base lang={lang} title={c.title} description={c.desc} alternates={alternates} jsonLd={jsonLd}>
  <main class="page">
    <PageHead title={c.title} lede={c.desc} lang={lang} crumbs={[[c.nav, connectPath(lang)]]}>
      <AppLinks slot="actions" lang={lang} here />
    </PageHead>

    <Section title={c.address} id="address">
      <div>
        <p>{s.s_connector_p}</p>
        <CopyUrl url={new URL("/mcp", SITE).href} copy={s.copy} copied={s.copied} />
      </div>
    </Section>

    {c.apps.map((app) => (
      <Section id={`${app.id}-title`} anchor={app.id}>
        <Fragment slot="heading">
          <Logo app={app.id} large />
          {app.name}
        </Fragment>
        <div>
          <p>{app.note}</p>
          <ol class="howto">
            {app.steps.map((step) => (
              <li>{step}</li>
            ))}
          </ol>
        </div>
      </Section>
    ))}

    <Section title={c.other} id="other">
      <div>
        <p>{c.other_p}</p>
      </div>
    </Section>

    <Section title={s.s_progress} id="progress">
      <div>
        <p>{s.s_progress_p}</p>
        <p class="note">{c.logos}</p>
      </div>
    </Section>
  </main>
</Base>

<style>
  /* The steps in each AI app, numbered in red like the steps of "How it works". */
  .howto {
    list-style: decimal;
    padding-left: 1.25rem;
    margin-top: 0.375rem;
  }
  .howto li + li {
    margin-top: 0.375rem;
  }
  /* The steps name English menu items: no German hyphenation inside them. */
  .howto li {
    hyphens: manual;
  }
  .howto li::marker {
    color: var(--red);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }
</style>
