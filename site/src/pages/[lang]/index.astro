---
import type { InferGetStaticPropsType } from "astro";
// Homepage in one language, at /de/, /en/, /fr/ and so on. The language picker is at /.
import Base from "../../layouts/Base.astro";
import QuestionMap from "../../components/home/QuestionMap.astro";
import ChatDemo from "../../components/home/ChatDemo.astro";
import AppLinks from "../../components/ui/AppLinks.astro";
import Button from "../../components/ui/Button.astro";
import CopyUrl from "../../components/ui/CopyUrl.astro";
import Facts from "../../components/ui/Facts.svelte";
import Pairs from "../../components/ui/Pairs.astro";
import Section from "../../components/ui/Section.astro";
import ReviewTimeline from "../../components/home/ReviewTimeline.astro";
import { homePath, methodPath, connectPath } from "../../data.ts";
import { SITE } from "../../site.ts";
import { texts, LANGUAGES } from "../../i18n.ts";

export function getStaticPaths() {
  return LANGUAGES.map((lang) => ({ params: { lang }, props: { lang } }));
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { lang } = Astro.props;
const s = texts(lang).site.home;
const alternates = Object.fromEntries(LANGUAGES.map((id) => [id, homePath(id)]));
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "Swiss Passport",
  url: new URL(homePath(lang), SITE).href,
  description: s.description,
  inLanguage: lang,
};
---

<Base lang={lang} title={s.title} description={s.description} alternates={alternates} jsonLd={jsonLd} xDefault="/">
  <script is:inline slot="head">
    if (!matchMedia("(prefers-reduced-motion: reduce)").matches) document.documentElement.classList.add("js-motion");
  </script>
  <main class="page">
    <section class="hero" aria-labelledby="title">
      <div class="hero-head">
        <h1 id="title">{s.h1}</h1>
        <p class="lede">{s.lede}</p>
        <p class="note">{s.unofficial}</p>
        <p class="cta">
          <Button href={connectPath(lang)}>{s.cta}</Button>
        </p>
        <AppLinks lang={lang} class="apps" />
        <p class="note">
          <a href="/learn/">{s.cta_browser} →</a>
        </p>
      </div>
    </section>

    <Section title={s.how} id="how">
      <ol class="steps">
        <li>
          <span class="n">1</span>
          <p>{s.step1}</p>
        </li>
        <li>
          <span class="n">2</span>
          <p>{s.step2}</p>
        </li>
        <li>
          <span class="n">3</span>
          <p>{s.step3}</p>
        </li>
      </ol>
      <ChatDemo lang={lang} />
    </Section>

    <Section title={s.method} id="method">
      <dl class="method">
        <div>
          <dt>{s.m1t}</dt>
          <dd>{s.m1d}</dd>
        </div>
        <div>
          <dt>{s.m2t}</dt>
          <dd>{s.m2d}</dd>
        </div>
        <div>
          <dt>{s.m3t}</dt>
          <dd>{s.m3d}</dd>
        </div>
        <div>
          <dt>{s.m4t}</dt>
          <dd>{s.m4d}</dd>
        </div>
        <div>
          <dt>{s.m5t}</dt>
          <dd>{s.m5d}</dd>
        </div>
        <div>
          <dt>{s.m6t}</dt>
          <dd>{s.m6d}</dd>
        </div>
      </dl>
      <p class="note">
        <a href={methodPath(lang)}>{texts(lang).site.method.link} →</a>
      </p>
    </Section>

    <Section title={s.reviews} id="reviews">
      <div>
        <p>{s.reviews_p}</p>
        <ReviewTimeline />
        <p class="small">{s.reviews_caption}</p>
      </div>
    </Section>

    <Section title={s.contents} id="contents">
      <div>
        <Facts
          rows={[
            [350, s.f1],
            [37, s.f2],
            [96, s.f3],
            [LANGUAGES.length, s.f4],
            [50, s.f5],
          ]}
        />
        <QuestionMap lang={lang} />
        <p class="note">{s.contents_note}</p>
      </div>
    </Section>

    <Section title={s.start} id="start-title" anchor="start">
      <Pairs>
        <h3>{s.s_connector}</h3>
        <p>{s.s_connector_p}</p>
        <CopyUrl url={new URL("/mcp", SITE).href} copy={s.copy} copied={s.copied} />
        <div>
          <AppLinks lang={lang} class="apps" />
          <p class="note">
            <a href={connectPath(lang)}>{texts(lang).site.connect.link} →</a>
          </p>
        </div>
        <h3>{s.s_browser}</h3>
        <p set:html={s.s_browser_p} />
        <h3>{s.s_progress}</h3>
        <p>{s.s_progress_p}</p>
      </Pairs>
    </Section>
  </main>
</Base>

<script>
  // Homepage motion: the Swiss cross of the masthead and the review timeline.
  import "../../scripts/main.js";
</script>

<style>
  /* The headline, as large as the longest word allows, then the lead and the ways to start in the text column. */
  .hero {
    padding-bottom: calc(3 * var(--line));
  }
  .hero-head {
    display: grid;
    grid-template-columns: var(--grid);
    column-gap: var(--gutter);
  }
  .hero-head > * {
    grid-column: 1 / -1;
  }
  .hero h1 {
    font-size: var(--xxl);
    line-height: 0.94;
    letter-spacing: var(--xxl-track);
    margin-inline-start: -0.054em;
    hyphens: manual; /* sized so that the longest word fits */
  }
  .hero .lede {
    margin-top: calc(2 * var(--line));
  }
  .cta,
  .apps {
    margin-top: var(--line);
  }
  @media (min-width: 40rem) {
    .hero .lede,
    .hero .cta,
    .hero .apps,
    .hero-head .note {
      grid-column: 1 / span 6;
    }
  }
  @media (min-width: 64rem) {
    .hero .lede,
    .hero .cta,
    .hero .apps,
    .hero-head .note {
      grid-column: 4 / span 6;
    }
  }
  /* Display leading snaps to the 6px unit. */
  @supports (line-height: round(1em, 1px)) {
    .hero h1 {
      line-height: round(0.94em, 0.375rem);
    }
  }

  /* How it works: three steps, three columns. */
  .steps {
    row-gap: var(--line);
  }
  .steps .n {
    display: block;
    margin-bottom: 0.375rem;
    font-size: var(--l);
    line-height: var(--l-lh);
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--red);
    font-variant-numeric: tabular-nums;
  }
  @media (min-width: 40rem) {
    :global(.row) .steps > li {
      grid-column: span 4;
    }
    :global(.row) .steps > li:last-child {
      grid-column: 1 / span 4;
    }
  }
  @media (min-width: 64rem) {
    :global(.row) .steps > li,
    :global(.row) .steps > li:last-child {
      grid-column: span 3;
    }
  }

  /* The method: six principles in three columns. */
  .method {
    row-gap: var(--line);
  }
  @media (min-width: 40rem) {
    :global(.row) .method > div {
      grid-column: span 4;
    }
  }
  @media (min-width: 64rem) {
    :global(.row) .method > div {
      grid-column: span 3;
    }
  }
</style>
