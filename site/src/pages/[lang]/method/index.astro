---
import type { InferGetStaticPropsType } from "astro";
// The learning method: what Swiss Passport does (retrieval, spacing, feedback, mixing) and the research behind it.
// Sections 2 to 5 each show a visual (src/components/method/) that lets the reader try the idea.
import Base from "../../../layouts/Base.astro";
import PageHead from "../../../components/ui/PageHead.astro";
import Section from "../../../components/ui/Section.astro";
import Prose from "../../../components/ui/Prose.astro";
import Sources from "../../../components/ui/Sources.astro";
import PageNav from "../../../components/ui/PageNav.astro";
import ForgettingCurve from "../../../components/method/ForgettingCurve.astro";
import TryQuestion from "../../../components/method/TryQuestion.astro";
import MixedPractice from "../../../components/method/MixedPractice.astro";
import LanguageSwitch from "../../../components/method/LanguageSwitch.astro";
import "../../../styles/viz.css";
import { UI } from "../../../ui.ts";
import { METHOD, SOURCES } from "../../../method.ts";
import { MAKERS } from "../../../about.ts";
import { SITE } from "../../../site.ts";
import { LANG_IDS, methodPath, questionsPath } from "../../../data.ts";

export function getStaticPaths() {
  return LANG_IDS.map((lang) => ({ params: { lang }, props: { lang } }));
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { lang } = Astro.props;
const m = METHOD[lang];
const ui = UI[lang];
const alternates = Object.fromEntries(LANG_IDS.map((id) => [id, methodPath(id)]));
const doi = (id: string) => `https://doi.org/${id}`;
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: m.title,
  description: m.desc,
  inLanguage: lang,
  url: new URL(methodPath(lang), SITE).href,
  author: MAKERS,
  isPartOf: { "@type": "WebSite", name: "Swiss Passport", url: SITE },
  citation: SOURCES.map((s) => ({ "@type": "ScholarlyArticle", name: s.cite, url: doi(s.doi) })),
};
---

<Base lang={lang} title={m.title} description={m.desc} alternates={alternates} jsonLd={jsonLd}>
  <main class="page">
    <PageHead title={m.title} lede={m.lede} lang={lang} crumbs={[[m.nav, methodPath(lang)]]} />

    {m.sections.map(([heading, paragraphs], i) => (
      <Section title={heading} id={`m${i}`}>
        <Prose>
          {paragraphs.map((p) => (
            <p>{p}</p>
          ))}
          {i === 1 && <ForgettingCurve lang={lang} />}
          {i === 2 && <TryQuestion lang={lang} id="q001" />}
          {i === 3 && <MixedPractice lang={lang} />}
          {i === 4 && <LanguageSwitch lang={lang} id="q002" />}
        </Prose>
      </Section>
    ))}

    <Section title={ui.sources} id="sources">
      <Sources items={SOURCES.map((s) => ({ href: doi(s.doi), label: `doi:${s.doi}`, text: s.cite, lang: "en" }))} />
    </Section>

    <PageNav label={m.link} action={ui.practise} links={[{ href: questionsPath(lang), label: ui.nav_questions }]} />
  </main>
</Base>

<script>
  import "../../../scripts/method-viz.js";
</script>
