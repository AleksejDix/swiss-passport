---
import type { ImageMetadata, InferGetStaticPropsType } from "astro";
// About: who is behind the site, where the content comes from, how it is checked, privacy and license.
import Base from "../../../layouts/Base.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import { ABOUT, ABOUT_LINKS, MAKERS } from "../../../about.ts";
import { SITE } from "../../../site.ts";
import aleksejPhoto from "../../../assets/makers/aleksej-dix.jpg";
import lidiaPhoto from "../../../assets/makers/lidia-dix.jpg";
import { LANG_IDS, aboutPath, guidePath } from "../../../data.ts";

export function getStaticPaths() {
  return LANG_IDS.map((lang) => ({ params: { lang }, props: { lang } }));
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { lang } = Astro.props;
const a = ABOUT[lang];
const links = { ...ABOUT_LINKS, guide: guidePath(lang) };
const fill = (html: string) => html.replace(/\{(\w+)\}/g, (_, k: string) => (links as Record<string, string>)[k]);
const alternates = Object.fromEntries(LANG_IDS.map((id) => [id, aboutPath(id)]));
// The makers with their LinkedIn photos, shown under "Who".
const PHOTOS: Record<string, ImageMetadata> = { "Aleksej Dix": aleksejPhoto, "Lidia Dix": lidiaPhoto };
const makers = MAKERS.map((m) => ({ ...m, image: new URL(PHOTOS[m.name].src, SITE).href }));
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "AboutPage",
  name: a.title,
  inLanguage: lang,
  url: new URL(aboutPath(lang), SITE).href,
  mainEntity: {
    "@type": "WebSite",
    name: "Swiss Passport",
    url: SITE,
    author: makers,
    license: "https://creativecommons.org/licenses/by-nc-sa/4.0/",
  },
};
---
<Base lang={lang} title={a.title} description={a.desc} alternates={alternates} jsonLd={jsonLd}>
<main class="page">
  <header class="qhead">
    <Breadcrumbs lang={lang} items={[[a.nav, aboutPath(lang)]]} />
    <h1>{a.title}</h1>
    <p class="lede">{a.desc}</p>
  </header>
  {a.sections.map(([heading, paragraphs], i) => (
    <section class="row" aria-labelledby={`a${i}`}>
      <h2 id={`a${i}`}>{heading}</h2>
      <div class="prose">
        {paragraphs.map((html) => <p set:html={fill(html)} />)}
        {i === 0 && (
          <div class="makers">
            {makers.map((m) => (
              <figure>
                <img src={PHOTOS[m.name].src} width={PHOTOS[m.name].width} height={PHOTOS[m.name].height} alt="">
                <figcaption><a href={m.url}>{m.name}</a></figcaption>
              </figure>
            ))}
          </div>
        )}
      </div>
    </section>
  ))}
</main>
</Base>
