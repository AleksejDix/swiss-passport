---
import type { ImageMetadata, InferGetStaticPropsType } from "astro";
// About: who is behind the site, where the content comes from, how it is checked, privacy and license.
import Base from "../../../layouts/Base.astro";
import PageHead from "../../../components/ui/PageHead.astro";
import Section from "../../../components/ui/Section.astro";
import Prose from "../../../components/ui/Prose.astro";
import { ABOUT_LINKS, MAKERS } from "../../../about.ts";
import { SITE } from "../../../site.ts";
import aleksejPhoto from "../../../assets/makers/aleksej-dix.jpg";
import lidiaPhoto from "../../../assets/makers/lidia-dix.jpg";
import { aboutPath, guidePath } from "../../../data.ts";
import { texts, LANGUAGES } from "../../../i18n.ts";

export function getStaticPaths() {
  return LANGUAGES.map((lang) => ({ params: { lang }, props: { lang } }));
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { lang } = Astro.props;
const a = texts(lang).site.about;
const links = { ...ABOUT_LINKS, guide: guidePath(lang) };
const fill = (html: string) => html.replace(/\{(\w+)\}/g, (_, k: string) => (links as Record<string, string>)[k]);
const alternates = Object.fromEntries(LANGUAGES.map((id) => [id, aboutPath(id)]));
// The makers with their LinkedIn photos, shown under "Who".
const PHOTOS: Record<string, ImageMetadata> = { "Aleksej Dix": aleksejPhoto, "Lidia Dix": lidiaPhoto };
const makers = MAKERS.map((m) => ({ ...m, image: new URL(PHOTOS[m.name].src, SITE).href }));
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "AboutPage",
  name: a.title,
  inLanguage: lang,
  url: new URL(aboutPath(lang), SITE).href,
  mainEntity: {
    "@type": "WebSite",
    name: "Swiss Passport",
    url: SITE,
    author: makers,
    license: "https://creativecommons.org/licenses/by-nc-sa/4.0/",
  },
};
---

<Base lang={lang} title={a.title} description={a.desc} alternates={alternates} jsonLd={jsonLd}>
  <main class="page">
    <PageHead title={a.title} lede={a.desc} lang={lang} crumbs={[[a.nav, aboutPath(lang)]]} />
    {a.sections.map(([heading, paragraphs], i) => (
      <Section title={heading} id={`a${i}`}>
        <Prose>
          {paragraphs.map((html) => (
            <p set:html={fill(html)} />
          ))}
          {i === 0 && (
            <div class="makers">
              {makers.map((m) => (
                <figure>
                  <img src={PHOTOS[m.name].src} width={PHOTOS[m.name].width} height={PHOTOS[m.name].height} alt="" />
                  <figcaption>
                    <a href={m.url}>{m.name}</a>
                  </figcaption>
                </figure>
              ))}
            </div>
          )}
        </Prose>
      </Section>
    ))}
  </main>
</Base>

<style>
  /* The makers as square portraits on the grid, two columns each on phones, three from tablets on. */
  .makers {
    display: grid;
    grid-template-columns: subgrid;
    align-items: start;
    row-gap: var(--line);
    margin-top: var(--line);
  }
  .makers figure {
    grid-column: span 2;
  }
  .makers img {
    display: block;
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
  }
  .makers figcaption {
    margin-top: 0.375rem;
    font-size: var(--xs);
    line-height: var(--xs-lh);
  }
  @media (min-width: 40rem) {
    .makers figure {
      grid-column: span 3;
    }
  }
</style>
