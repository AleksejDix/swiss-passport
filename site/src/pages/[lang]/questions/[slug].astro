---
import type { InferGetStaticPropsType } from "astro";
import type { Letter } from "../../../../../i18n/index.js";
// One page per official question and language: the question, the correct answer, why, and the German original.
import Base from "../../../layouts/Base.astro";
import PageHead from "../../../components/ui/PageHead.astro";
import Section from "../../../components/ui/Section.astro";
import AnswerList from "../../../components/ui/AnswerList.svelte";
import AnswerRow from "../../../components/ui/AnswerRow.svelte";
import Mnemonic from "../../../components/ui/Mnemonic.svelte";
import Sources from "../../../components/ui/Sources.astro";
import PageNav from "../../../components/ui/PageNav.astro";
import TopicVisual from "../../../components/topics/TopicVisual.astro";
import { visualFor } from "../../../viz/topic-visuals.ts";
import { UI } from "../../../ui.ts";
import {
  TEXT,
  LANG_IDS,
  lessons,
  questions,
  questionPath,
  questionsPath,
  topicPath,
  checkedMonth,
} from "../../../data.ts";
import { LINKS } from "../../../guide.ts";
import { OPERATOR } from "../../../legal.ts";
import { SITE } from "../../../site.ts";

export function getStaticPaths() {
  return LANG_IDS.flatMap((lang) =>
    questions.map((q, i) => ({
      params: { lang, slug: q.slug },
      props: { lang, q, prev: questions[i - 1], next: questions[i + 1] },
    })),
  );
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { lang, q, prev, next } = Astro.props;
const ui = UI[lang];
const t = TEXT[lang];
const text = t.questions[q.id];
const de = TEXT.de.questions[q.id];
const letters = q.options.map((o) => o.id);
const right = q.answer;
const concept = t.concepts[q.concept.id];
const lesson = t.lessons[q.lesson];
const unit = lessons.find((l) => l.id === q.lesson)!.unit;
const img = (path: string) => `/${path}`;

// Some official questions share their wording; the answer keeps those titles apart.
const shared = questions.some((o) => o.id !== q.id && t.questions[o.id].question === text.question);
const answerTitle = text.options[right].charAt(0).toUpperCase() + text.options[right].slice(1);
const title = shared ? `${text.question} ${answerTitle} | ${ui.title_suffix}` : `${text.question} | ${ui.title_suffix}`;
const description = `${ui.answer}: ${right.toUpperCase()}, ${text.options[right]}. ${text.why}`.slice(0, 300);
const alternates = Object.fromEntries(LANG_IDS.map((id) => [id, questionPath(id, q)]));
// Links to the question in the official list, and an email about a mistake with the question and page filled in.
const credit = ui.credit.replace("{n}", String(q.n)).replace("{pdf}", LINKS.pdf);
const subject = ui.report_subject.replace("{n}", String(q.n));
const report = `mailto:${OPERATOR.email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(new URL(questionPath(lang, q), SITE).href + "\n\n")}`;

// schema.org Quiz with one multiple choice question (Google "Education Q&A").
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Quiz",
  inLanguage: lang,
  about: { "@type": "Thing", name: t.title },
  educationalLevel: "Grundkenntnistest Kanton Zürich",
  hasPart: [
    {
      "@type": "Question",
      eduQuestionType: "Multiple choice",
      learningResourceType: "Practice problem",
      name: text.question,
      text: text.question,
      suggestedAnswer: letters
        .filter((l) => l !== right)
        .map((l) => ({
          "@type": "Answer",
          position: letters.indexOf(l),
          text: text.options[l],
        })),
      acceptedAnswer: {
        "@type": "Answer",
        position: letters.indexOf(right),
        text: text.options[right],
        answerExplanation: { "@type": "Comment", text: text.why },
      },
    },
  ],
};
---

<Base lang={lang} title={title} description={description} alternates={alternates} jsonLd={jsonLd}>
  <main class="page">
    <PageHead
      title={text.question}
      lang={lang}
      crumbs={[
        [ui.nav_questions, questionsPath(lang)],
        [concept.title, topicPath(lang, q.concept)],
        [ui.question_n.replace("{n}", String(q.n)), questionPath(lang, q)],
      ]}
    >
      {lang !== "de" && (
        <p class="qde" lang="de">
          {de.question}
        </p>
      )}
      {q.image && <img class="qpicture" src={img(q.image)} alt={text.question} loading="lazy" />}
    </PageHead>

    <Section title={`${ui.answer}: ${right.toUpperCase()}`} id="answer">
      <AnswerList>
        {q.options.map((o) => (
          <AnswerRow letter={o.id} right={o.id === right}>
            {o.image && <img src={img(o.image)} alt={text.options[o.id]} loading="lazy" />}
            {text.options[o.id]}
            {lang !== "de" && <small lang="de">{de.options[o.id]}</small>}
          </AnswerRow>
        ))}
      </AnswerList>
    </Section>

    <Section title={ui.why} id="why">
      <div>
        <p>{text.why}</p>
        {/* Where the official answer is outdated or simplified: what applies today. */}
        {text.note && <Mnemonic>{text.note}</Mnemonic>}
        {text.distractors && Object.keys(text.distractors).length > 0 && (
          <>
            <h3>{ui.mistakes}</h3>
            <dl class="mistakes">
              {Object.entries(text.distractors).map(([l, why]) => (
                <>
                  <dt>
                    {l.toUpperCase()}: {text.options[l as Letter]}
                  </dt>
                  <dd>{why}</dd>
                </>
              ))}
            </dl>
          </>
        )}
      </div>
    </Section>

    <Section title={ui.topic} id="topic">
      <div>
        <p>
          <strong>
            <a href={topicPath(lang, q.concept)}>{concept.title}</a>
          </strong>
        </p>
        <p>{concept.intro[0]}</p>
        {visualFor(q.concept.id) && <TopicVisual lang={lang} topic={q.concept.id} />}
        <p class="small">
          {t.units[unit].title}
          <br />
          {lesson.title}
        </p>
        {q.concept.sources?.length > 0 && (
          <>
            <h3>{ui.sources}</h3>
            <Sources items={q.concept.sources.map((href) => ({ href }))} />
            <p class="note">{ui.checked.replace("{date}", checkedMonth(lang))}</p>
          </>
        )}
        <p class="note" set:html={credit} />
        <p class="note">
          <a href={report}>{ui.report}</a>
        </p>
      </div>
    </Section>

    <PageNav
      label={ui.nav_questions}
      action={ui.practise}
      links={[
        ...(prev ? [{ href: questionPath(lang, prev), label: `← ${ui.prev}`, rel: "prev" as const }] : []),
        ...(next ? [{ href: questionPath(lang, next), label: `${ui.next} →`, rel: "next" as const }] : []),
        { href: questionsPath(lang), label: ui.nav_questions },
      ]}
    />
  </main>
</Base>

<style>
  /* The question in German, the wording of the real test. */
  .qde {
    font-size: var(--m);
    line-height: var(--m-lh);
    letter-spacing: -0.012em;
    color: var(--grey);
    margin-top: var(--line);
  }
  .qpicture {
    display: block;
    max-height: 24rem;
    width: auto;
    margin-top: calc(2 * var(--line));
  }
  .mistakes dt {
    margin-top: 0.75rem;
  }
  .mistakes dt:first-child {
    margin-top: 0;
  }
  @media (min-width: 64rem) {
    .qde {
      grid-column: 1 / span 8;
    }
  }
</style>
