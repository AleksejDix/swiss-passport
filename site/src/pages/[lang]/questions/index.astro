---
import type { InferGetStaticPropsType } from "astro";
// All 350 questions in one language, grouped by unit, lesson and topic, each linking to its own page.
import Base from "../../../layouts/Base.astro";
import PageHead from "../../../components/ui/PageHead.astro";
import Section from "../../../components/ui/Section.astro";
import Pairs from "../../../components/ui/Pairs.astro";
import Button from "../../../components/ui/Button.astro";
import { UI } from "../../../ui.ts";
import { TEXT, LANG_IDS, units, topics, questionPath, questionsPath, topicPath } from "../../../data.ts";

export function getStaticPaths() {
  return LANG_IDS.map((lang) => ({ params: { lang }, props: { lang } }));
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { lang } = Astro.props;
const ui = UI[lang];
const t = TEXT[lang];
const alternates = Object.fromEntries(LANG_IDS.map((id) => [id, questionsPath(id)]));
---

<Base lang={lang} title={ui.questions_title} description={ui.questions_desc} alternates={alternates}>
  <main class="page">
    <PageHead
      title={ui.questions_title}
      lede={ui.questions_lede}
      lang={lang}
      crumbs={[[ui.nav_questions, questionsPath(lang)]]}
    >
      <Button slot="actions" href="/learn/">
        {ui.practise}
      </Button>
    </PageHead>

    {units.map((u) => (
      <Section title={t.units[u.id].title} id={u.id}>
        <Pairs>
          {u.lessons.map((l) => (
            <>
              <h3 id={l}>{t.lessons[l].title}</h3>
              {topics
                .filter((c) => c.lesson === l)
                .map((c) => (
                  <>
                    <h4>
                      <a href={topicPath(lang, c)}>{t.concepts[c.id].title}</a>
                    </h4>
                    <ol class="qlist">
                      {c.questions.map((q) => (
                        <li value={q.n}>
                          <a href={questionPath(lang, q)}>{t.questions[q.id].question}</a>
                        </li>
                      ))}
                    </ol>
                  </>
                ))}
            </>
          ))}
        </Pairs>
      </Section>
    ))}
  </main>
</Base>

<style>
  /* Lessons as labels, the questions with their official numbers hanging in the gutter. */
  .qlist {
    list-style: decimal;
    padding-left: 2.25rem;
  }
  .qlist li {
    padding-block: 0.1875rem;
  }
  .qlist li::marker {
    color: var(--grey);
    font-size: var(--xs);
    font-variant-numeric: tabular-nums;
  }
  /* In a list where every line is a link, the underline only marks the one under the pointer. */
  .qlist a {
    text-decoration: none;
  }
  .qlist a:hover {
    text-decoration: underline;
  }
</style>
