---
import type { InferGetStaticPropsType } from "astro";
// One page per topic and language: the explanation, key terms, a memory aid, and the exam questions on it.
import Base from "../../../layouts/Base.astro";
import PageHead from "../../../components/ui/PageHead.astro";
import Section from "../../../components/ui/Section.astro";
import Prose from "../../../components/ui/Prose.astro";
import Pairs from "../../../components/ui/Pairs.astro";
import Mnemonic from "../../../components/ui/Mnemonic.astro";
import Sources from "../../../components/ui/Sources.astro";
import PageNav from "../../../components/ui/PageNav.astro";
import TopicVisual from "../../../components/topics/TopicVisual.astro";
import { visualFor, visualTitle } from "../../../viz/topic-visuals.ts";
import { UI } from "../../../ui.ts";
import { SITE } from "../../../site.ts";
import { TEXT, LANG_IDS, topics, questionPath, questionsPath, topicPath, checkedMonth } from "../../../data.ts";

export function getStaticPaths() {
  return LANG_IDS.flatMap((lang) =>
    topics.map((c, i) => ({
      params: { lang, topic: c.id.replace(/_/g, "-") },
      props: { lang, c, prev: topics[i - 1], next: topics[i + 1] },
    })),
  );
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { lang, c, prev, next } = Astro.props;
const ui = UI[lang];
const t = TEXT[lang];
const topic = t.concepts[c.id];

const title = `${topic.title} | ${ui.title_suffix}`;
const description = topic.intro[0].length > 300 ? `${topic.intro[0].slice(0, 297)}...` : topic.intro[0];
const alternates = Object.fromEntries(LANG_IDS.map((id) => [id, topicPath(id, c)]));
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "LearningResource",
  name: topic.title,
  description,
  inLanguage: lang,
  learningResourceType: "Explanation",
  educationalLevel: "Grundkenntnistest Kanton Zürich",
  isPartOf: { "@type": "WebSite", name: "Swiss Passport", url: SITE },
  citation: c.sources,
};
---

<Base lang={lang} title={title} description={description} alternates={alternates} jsonLd={jsonLd}>
  <main class="page">
    <PageHead
      title={topic.title}
      lang={lang}
      crumbs={[
        [ui.nav_questions, questionsPath(lang)],
        [topic.title, topicPath(lang, c)],
      ]}
    />

    <Section title={ui.topic} id="intro">
      <Prose>
        {topic.intro.map((p) => (
          <p>{p}</p>
        ))}
        {topic.mnemonic && (
          <Mnemonic>
            <strong>{ui.mnemonic}:</strong> {topic.mnemonic}
          </Mnemonic>
        )}
      </Prose>
    </Section>

    {visualFor(c.id) && (
      <Section title={visualTitle(c.id, lang)} id="visual">
        <div>
          <TopicVisual lang={lang} topic={c.id} caption={false} />
        </div>
      </Section>
    )}

    {topic.key_terms?.length > 0 && (
      <Section title={ui.key_terms} id="terms">
        <Pairs as="dl">
          {topic.key_terms.map((k) => (
            <>
              <dt lang="de">{k.term}</dt>
              <dd>{k.definition}</dd>
            </>
          ))}
        </Pairs>
      </Section>
    )}

    <Section title={ui.topic_questions} id="questions">
      <ol class="tq">
        {c.questions.map((q) => (
          <li>
            <a href={questionPath(lang, q)}>{t.questions[q.id].question}</a>
            <span class="small">
              {ui.answer}: {q.answer.toUpperCase()}, {t.questions[q.id].options[q.answer]}
            </span>
          </li>
        ))}
      </ol>
    </Section>

    {c.sources?.length > 0 && (
      <Section title={ui.sources} id="sources">
        <Sources items={c.sources.map((href) => ({ href }))} />
        <p class="note">{ui.checked.replace("{date}", checkedMonth(lang))}</p>
      </Section>
    )}

    <PageNav
      label={ui.topic}
      action={ui.practise}
      links={[
        ...(prev ? [{ href: topicPath(lang, prev), label: `← ${ui.prev_topic}`, rel: "prev" as const }] : []),
        ...(next ? [{ href: topicPath(lang, next), label: `${ui.next_topic} →`, rel: "next" as const }] : []),
        { href: questionsPath(lang), label: ui.nav_questions },
      ]}
    />
  </main>
</Base>

<style>
  /* The questions of the topic, each with its answer. */
  .tq li {
    border-top: 1px solid var(--rule);
    padding-block: 0.75rem;
  }
  .tq li:first-child {
    border-top: 0;
    padding-top: 0;
  }
  .tq .small {
    display: block;
    margin-top: 0.1875rem;
  }
  /* In a list where every line is a link, the underline only marks the one under the pointer. */
  .tq a {
    text-decoration: none;
  }
  .tq a:hover {
    text-decoration: underline;
  }
</style>
