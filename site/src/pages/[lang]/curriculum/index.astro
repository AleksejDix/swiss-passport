---
import type { InferGetStaticPropsType } from "astro";
// The curriculum: how the course is built and which lesson builds on which (issue #15).
// Stages come from requires in curriculum.json, the same rule the learning engine uses to offer lessons.
import Base from "../../../layouts/Base.astro";
import PageHead from "../../../components/ui/PageHead.astro";
import Section from "../../../components/ui/Section.astro";
import Facts from "../../../components/ui/Facts.svelte";
import PageNav from "../../../components/ui/PageNav.astro";
import CurriculumMap from "../../../components/curriculum/CurriculumMap.astro";
import QuestionMap from "../../../components/ui/QuestionMap.svelte";
import { questionMap } from "../../../viz/overview.ts";
import { units, lessons, concepts, questions, curriculumPath, methodPath, questionsPath } from "../../../data.ts";
import { texts, LANGUAGES } from "../../../i18n.ts";

export function getStaticPaths() {
  return LANGUAGES.map((lang) => ({ params: { lang }, props: { lang } }));
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { lang } = Astro.props;
const c = texts(lang).site.curriculum;
const ui = texts(lang).site.ui;
const alternates = Object.fromEntries(LANGUAGES.map((id) => [id, curriculumPath(id)]));
const figures = [units.length, lessons.length, concepts.length, questions.length];
---

<Base lang={lang} title={c.title} description={c.desc} alternates={alternates}>
  <main class="page">
    <PageHead title={c.title} lede={c.lede} lang={lang} crumbs={[[c.nav, curriculumPath(lang)]]} />

    <Section title={c.built_title} id="built">
      <div>
        <Facts rows={figures.map((n, i) => [n, c.facts[i]])} />
        {c.built_text.map((p) => (
          <p>{p}</p>
        ))}
        <QuestionMap client:visible {...questionMap(lang)} stored />
      </div>
    </Section>

    <Section title={c.order_title} id="order">
      <div>
        {c.order_text.map((p) => (
          <p>{p}</p>
        ))}
      </div>
    </Section>

    <CurriculumMap lang={lang} />

    <PageNav
      label={c.nav}
      action={ui.practise}
      links={[
        { href: questionsPath(lang), label: ui.nav_questions },
        { href: methodPath(lang), label: texts(lang).site.method.nav },
      ]}
    />
  </main>
</Base>
