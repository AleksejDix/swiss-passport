---
import type { InferGetStaticPropsType } from "astro";
// The curriculum: how the course is built and which lesson builds on which (issue #15).
// Stages come from requires in curriculum.json, the same rule the learning engine uses to offer lessons.
import Base from "../../../layouts/Base.astro";
import PageHead from "../../../components/ui/PageHead.astro";
import Section from "../../../components/ui/Section.astro";
import Facts from "../../../components/ui/Facts.svelte";
import PageNav from "../../../components/ui/PageNav.astro";
import CurriculumMap from "../../../components/curriculum/CurriculumMap.astro";
import { UI } from "../../../ui.ts";
import { METHOD } from "../../../method.ts";
import { CURRICULUM } from "../../../curriculum.ts";
import {
  LANG_IDS,
  units,
  lessons,
  concepts,
  questions,
  curriculumPath,
  methodPath,
  questionsPath,
} from "../../../data.ts";

export function getStaticPaths() {
  return LANG_IDS.map((lang) => ({ params: { lang }, props: { lang } }));
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { lang } = Astro.props;
const c = CURRICULUM[lang];
const ui = UI[lang];
const alternates = Object.fromEntries(LANG_IDS.map((id) => [id, curriculumPath(id)]));
const figures = [units.length, lessons.length, concepts.length, questions.length];
---

<Base lang={lang} title={c.title} description={c.desc} alternates={alternates}>
  <main class="page">
    <PageHead title={c.title} lede={c.lede} lang={lang} crumbs={[[c.nav, curriculumPath(lang)]]} />

    <Section title={c.built_title} id="built">
      <div>
        <Facts rows={figures.map((n, i) => [n, c.facts[i]])} />
        {c.built_text.map((p) => (
          <p>{p}</p>
        ))}
      </div>
    </Section>

    <Section title={c.order_title} id="order">
      <div>
        {c.order_text.map((p) => (
          <p>{p}</p>
        ))}
      </div>
    </Section>

    <CurriculumMap lang={lang} />

    <PageNav
      label={c.nav}
      action={ui.practise}
      links={[
        { href: questionsPath(lang), label: ui.nav_questions },
        { href: methodPath(lang), label: METHOD[lang].nav },
      ]}
    />
  </main>
</Base>
