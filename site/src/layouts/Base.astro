---
// Every page except /learn: head with canonical and language alternates, masthead, footer.
// The font is served from this site, not from Google.
import "@fontsource-variable/inter/opsz.css";
// Preloaded so the first paint already uses Inter and text does not reflow when the font arrives.
import interLatin from "@fontsource-variable/inter/files/inter-latin-opsz-normal.woff2?url";
import "../styles/styles.css";
import { SITE } from "../site.js";
import { LANGS, STRINGS } from "../scripts/i18n.js";
import { UI } from "../ui.js";
import { GUIDE } from "../guide.js";
import { ABOUT } from "../about.js";
import { METHOD } from "../method.js";
import { homePath, questionsPath, guidePath, aboutPath, methodPath } from "../data.js";

const { lang, title, description, alternates, jsonLd, xDefault, mapCredit = false, remember = true } = Astro.props;
const s = { ...STRINGS[lang], ...UI[lang] };
const url = (path) => new URL(path, SITE).href;
// The legal pages are in German; the footer names them in the reader's language.
const PRIVACY_LABEL = { de: "Datenschutz", en: "Privacy", fr: "Protection des données", it: "Protezione dei dati", ru: "Защита данных", uk: "Захист даних" };
---
<!doctype html>
<html lang={lang}>
<head>
<meta charset="utf-8">
<link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin>
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title>
<meta name="description" content={description}>
<link rel="canonical" href={url(alternates[lang])}>
{Object.entries(alternates).map(([id, path]) => <link rel="alternate" hreflang={id} href={url(path)}>)}
{xDefault && <link rel="alternate" hreflang="x-default" href={url(xDefault)}>}
<meta property="og:type" content="website">
<meta property="og:site_name" content="Swiss Passport">
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:url" content={url(alternates[lang])}>
<meta property="og:locale" content={lang}>
<meta property="og:image" content={url(`/og/${lang}.png`)}>
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta name="twitter:card" content="summary_large_image">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="sitemap" href="/sitemap-index.xml">
{jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
{remember && <script is:inline define:vars={{ lang }}>
  // Remember the language of the page, so / and /learn open in it next time.
  try { localStorage.setItem("sp-lang", lang); } catch { /* storage unavailable */ }
</script>}
<slot name="head" />
</head>
<body>
<header class="page masthead">
  <a class="brand" href={homePath(lang)} aria-label="Swiss Passport">
    <svg class="mark" viewBox="0 0 32 32" aria-hidden="true">
      <rect width="32" height="32" fill="var(--red)"/>
      <rect class="arm arm-h" x="6" y="13" width="20" height="6" fill="#fff"/>
      <rect class="arm arm-v" x="13" y="6" width="6" height="20" fill="#fff"/>
    </svg>
    <span>Swiss Passport</span>
  </a>
  <nav class="nav">
    <a href="/learn/">{s.nav_learn}</a>
    <a href={questionsPath(lang)}>{s.nav_questions}</a>
    <a href={guidePath(lang)}>{GUIDE[lang].nav}</a>
    <a href={methodPath(lang)}>{METHOD[lang].nav}</a>
  </nav>
  <nav class="langs-nav" aria-label="Language">
    {Object.entries(LANGS).map(([id, name]) => (
      <a href={alternates[id] ?? homePath(id)} hreflang={id} lang={id} aria-current={id === lang ? "page" : undefined} data-lang={id}>{name}</a>
    ))}
  </nav>
</header>

<slot />

<footer class="page">
  <div class="footer">
  <p>{s.foot}</p>
  {mapCredit && <p>{s.map_credit}</p>}
  <p><a href={aboutPath(lang)}>{ABOUT[lang].nav}</a> <a href="/impressum/">Impressum</a> <a href="/datenschutz/">{PRIVACY_LABEL[lang]}</a> <a href="https://github.com/AleksejDix/swiss-passport">{s.nav_source}</a> <a href="https://github.com/AleksejDix/swiss-passport/blob/main/LICENSE">{s.foot_license}</a></p>
  </div>
</footer>
<script is:inline>
  for (const a of document.querySelectorAll("[data-lang]")) {
    a.addEventListener("click", () => { try { localStorage.setItem("sp-lang", a.dataset.lang); } catch {} });
  }
</script>
</body>
</html>
