---
// Every page in a reader's language, except /learn: the document, what search engines read, masthead and footer.
import Document from "./Document.astro";
import Seo from "../components/layout/Seo.astro";
import Masthead from "../components/layout/Masthead.astro";
import Brand from "../components/layout/Brand.astro";
import MainNav from "../components/layout/MainNav.astro";
import LanguageNav from "../components/layout/LanguageNav.svelte";
import Footer from "../components/layout/Footer.astro";
import { homePath, aboutPath, sponsorsPath } from "../data.ts";
import { texts, LANGUAGE_NAMES } from "../i18n.ts";

interface Props {
  lang: string;
  title: string;
  description: string;
  /** This page in every language: { de: "/de/…", en: "/en/…" }. */
  alternates: Record<string, string>;
  /** schema.org data for search engines. */
  jsonLd?: object;
  /** The page for readers whose language is not offered (hreflang x-default). */
  xDefault?: string;
  /** Remember the page's language for / and /learn (off on pages that are not in the reader's language). */
  remember?: boolean;
}

const { lang, title, description, alternates, jsonLd, xDefault, remember = true } = Astro.props;
const s = { ...texts(lang).site.home, ...texts(lang).site.ui };
const REPO = "https://github.com/AleksejDix/swiss-passport";
---

<Document lang={lang} title={title} description={description} cyrillic={texts(lang).script === "Cyrl"}>
  <Fragment slot="head">
    <Seo
      title={title}
      description={description}
      path={alternates[lang]}
      alternates={alternates}
      xDefault={xDefault}
      locale={lang}
      image={`/og/${lang}.png`}
      jsonLd={jsonLd}
    />
    {remember && <script is:inline define:vars={{ lang }}>
      // Remember the language of the page, so / and /learn open in it next time.
      try {
        localStorage.setItem("sp-lang", lang);
      } catch {
        /* storage unavailable */
      }
    </script>}
    <slot name="head" />
  </Fragment>

  <Masthead>
    <Brand href={homePath(lang)} />
    <MainNav lang={lang} />
    <LanguageNav names={LANGUAGE_NAMES} lang={lang} label={s.nav_langs} links={alternates} />
  </Masthead>
  <script is:inline>
    // A language chosen in the masthead is remembered, so / and /learn open in it next time.
    for (const a of document.querySelectorAll("[data-lang]")) {
      a.addEventListener("click", () => {
        try {
          localStorage.setItem("sp-lang", a.dataset.lang);
        } catch {}
      });
    }
  </script>
  <slot />

  <Footer
    text={s.foot}
    links={[
      { href: aboutPath(lang), label: texts(lang).site.about.nav },
      { href: sponsorsPath(lang), label: texts(lang).site.sponsors.nav },
      { href: "/impressum/", label: "Impressum", lang: "de" },
      { href: "/datenschutz/", label: texts(lang).site.privacy },
      { href: REPO, label: s.nav_source },
      { href: `${REPO}/blob/main/LICENSE`, label: s.foot_license },
    ]}
  />
</Document>
